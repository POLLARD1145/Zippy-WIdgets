---
import { tools } from '@data/tools.ts';
import { posts, postUrl } from '@data/posts.ts';

const pathname = Astro.url.pathname;
const toolLinks = tools.filter(t => t.href !== '/game/');
const topLinks = [
  { href: '/game/', label: 'Games' },
  { href: '/blog/', label: 'Blog' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];

function isActive(href: string) {
  const current = pathname.replace(/\/$/, '') || '/';
  const target = href.replace(/\/$/, '') || '/';
  return current === target;
}

function isToolsActive() {
  return pathname.startsWith('/tool/');
}

const gameItems = [
  { icon: '🎮', name: 'Games Hub', desc: 'Browse all free browser games.', url: '/game/', tags: 'games hub' },
  { icon: '🔡', name: 'Daily Wordle', desc: 'Guess the hidden 5-letter word in 6 tries.', url: '/game/wordle/', tags: 'wordle word guess daily puzzle 5 letter' },
  { icon: '⚔️', name: 'AetherForge', desc: 'Daily roguelike deckbuilder card game.', url: '/game/aetherforge/', tags: 'aetherforge card game roguelike deckbuilder daily' },
  { icon: '🧩', name: 'Daily Word Scramble', desc: 'Unscramble the daily word puzzle.', url: '/game/word-scramble/', tags: 'word scramble puzzle daily' },
  { icon: '🌍', name: 'Emoji Geography', desc: 'Guess countries from flag emojis.', url: '/game/emoji-geography/', tags: 'emoji geography flags quiz country' },
  { icon: '🧠', name: 'Emoji Memory', desc: 'Match emoji pairs in a memory game.', url: '/game/emoji-memory/', tags: 'emoji memory match game' },
  { icon: '✊', name: 'Rock Paper Scissors', desc: 'Classic hand game against the computer.', url: '/game/rock-paper-scissors/', tags: 'rock paper scissors rps game' },
  { icon: '🔢', name: 'Daily Sudoku', desc: 'Free daily Sudoku puzzle with four difficulties.', url: '/game/sudoku/', tags: 'sudoku daily sudoku puzzle logic numbers' },
];

const tagIcons: Record<string, string> = {
  'PDF Tools': '📄',
  'Image Tools': '🖼️',
  'QR Code': '📷',
  'Speed Test': '📶',
  'Font Generator': '🔤',
  'Picker Wheel': '🎯',
  'Technology & AI': '🤖',
};

const blogItems = posts.map(p => ({
  icon: tagIcons[p.tag] || '📝',
  name: p.title,
  desc: p.description,
  url: postUrl(p.slug),
  tags: `${p.tag} ${p.title} ${p.description}`.toLowerCase(),
}));

const searchIndex = [
  ...tools.map(t => ({
    icon: t.icon,
    name: t.name,
    desc: t.description,
    url: t.href,
    tags: t.tags,
  })),
  ...gameItems,
  ...blogItems,
];

const isGamePage = pathname.startsWith('/game/') && pathname !== '/game/';
---
<nav class="navbar">
  <a class="nav-brand" href="/">
    <picture>
      <source srcset="/ZippyWidgets Logo.webp" type="image/webp" />
      <img src="/ZippyWidgets Logo-192.png" alt="ZippyWidgets" class="nav-logo" width="40" height="40" decoding="async" />
    </picture>
    ZippyWidgets
  </a>
  <div class="nav-search" id="navSearch">
    <span class="nav-search-icon" aria-hidden="true">🔍</span>
    <input class="nav-search-input" id="navSearchInput" type="search" placeholder="Search tools & games…" autocomplete="off" aria-label="Search tools and games" aria-controls="searchResults" aria-expanded="false" />
    <button class="nav-search-btn" id="navSearchBtn" aria-label="Open search" aria-expanded="false">🔍</button>
    <div class="search-results" id="searchResults" role="listbox" aria-label="Search results"></div>
  </div>
  <button class="nav-toggle" id="navToggle" aria-label="Toggle navigation" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
  <button class="theme-toggle" id="themeToggle" onclick="toggleTheme()" aria-label="Toggle light/dark mode">☀️</button>
  {isGamePage && (
    <button class="theme-toggle" id="muteToggle" onclick="toggleMute()" aria-label="Toggle sound">🔊</button>
  )}
  <div class="nav-links" id="navLinks">
    <div class="nav-dropdown">
      <button class={isToolsActive() ? 'nav-pill active' : 'nav-pill'} aria-haspopup="true" aria-expanded="false" id="toolsDropdownBtn">Tools ▾</button>
      <div class="dropdown-menu" aria-labelledby="toolsDropdownBtn">
        {toolLinks.map(tool => (
          <a class={isActive(tool.href) ? 'active' : ''} href={tool.href}>
            <span class="icon">{tool.icon}</span>
            <span>{tool.name}</span>
          </a>
        ))}
      </div>
    </div>
    {topLinks.map(link => (
      <a class={isActive(link.href) ? 'nav-pill active' : 'nav-pill'} href={link.href}>{link.label}</a>
    ))}
  </div>
</nav>

<style>
  .nav-dropdown { position: relative; }
  .nav-dropdown .nav-pill { background: none; border: 1px solid var(--border); cursor: pointer; }
  .dropdown-menu {
    display: none;
    position: absolute;
    top: calc(100% + .5rem);
    left: 0;
    min-width: 220px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: .5rem;
    flex-direction: column;
    gap: .2rem;
    box-shadow: 0 8px 24px rgba(0,0,0,.2);
    z-index: 200;
  }
  .dropdown-menu a {
    display: flex;
    align-items: center;
    gap: .6rem;
    padding: .55rem .75rem;
    border-radius: 8px;
    color: var(--text);
    text-decoration: none;
    font-size: .85rem;
    white-space: nowrap;
  }
  .dropdown-menu a:hover, .dropdown-menu a.active { background: var(--surface2); color: var(--accent); }
  .dropdown-menu a .icon { font-size: 1.1rem; }
  .nav-dropdown:hover .dropdown-menu,
  .nav-dropdown.open .dropdown-menu { display: flex; }
  .nav-dropdown:hover .nav-pill,
  .nav-dropdown.open .nav-pill,
  .nav-dropdown .nav-pill.active,
  .nav-pill:hover,
  .nav-pill.active { background: var(--accent); border-color: var(--accent); color: #fff; }

  @media (max-width: 640px) {
    .dropdown-menu {
      position: static;
      display: none;
      box-shadow: none;
      border: none;
      background: transparent;
      padding-left: 1rem;
      min-width: auto;
    }
    .nav-dropdown.open .dropdown-menu { display: flex; }
  }
</style>

<script is:inline>
  (function(){
    var t=document.getElementById('navToggle'),l=document.getElementById('navLinks');
    t.addEventListener('click',function(){var o=l.classList.toggle('open');t.classList.toggle('open',o);t.setAttribute('aria-expanded',o);});
    l.querySelectorAll('a').forEach(function(a){a.addEventListener('click',function(){l.classList.remove('open');t.classList.remove('open');t.setAttribute('aria-expanded','false');});});

    var ddb=document.getElementById('toolsDropdownBtn');
    if(ddb){
      var ddp=ddb.parentElement;
      // Click toggles the dropdown on all screen sizes; hover behavior remains via CSS
      ddb.addEventListener('click',function(e){
        e.stopPropagation();
        var o=!ddp.classList.contains('open');
        // Close any other open dropdowns first
        document.querySelectorAll('.nav-dropdown.open').forEach(function(el){ if(el !== ddp) el.classList.remove('open'); });
        ddp.classList.toggle('open',o);
        ddb.setAttribute('aria-expanded',o);
      });
      // Close dropdown when clicking outside it
      document.addEventListener('click',function(e){
        if(!ddp.contains(e.target)){
          ddp.classList.remove('open');
          ddb.setAttribute('aria-expanded','false');
        }
      });
      // Close dropdown when a dropdown link is clicked
      ddp.querySelectorAll('.dropdown-menu a').forEach(function(a){
        a.addEventListener('click',function(){
          ddp.classList.remove('open');
          ddb.setAttribute('aria-expanded','false');
        });
      });
    }

    // Sound mute toggle (games define their own toggleMute; this is a safe fallback)
    window.toggleMute = window.toggleMute || function() {};
    var m=document.getElementById('muteToggle');
    if(m){
      try { m.textContent = (localStorage.getItem('zw_mute') === '1') ? '🔇' : '🔊'; } catch(e){}
    }
  })();
</script>

<script is:inline define:vars={{ searchIndex }}>
  const SITE_INDEX = searchIndex;
  const searchWrap  = document.getElementById('navSearch');
  const searchInput = document.getElementById('navSearchInput');
  const searchBtn   = document.getElementById('navSearchBtn');
  const resultsBox  = document.getElementById('searchResults');
  let focusIdx = -1;

  function openSearch() {
    searchWrap.classList.add('open');
    searchBtn.setAttribute('aria-expanded', 'true');
    searchInput.setAttribute('aria-expanded', 'true');
    setTimeout(() => searchInput.focus(), 30);
  }
  function closeSearch() {
    searchWrap.classList.remove('open');
    searchBtn.setAttribute('aria-expanded', 'false');
    searchInput.setAttribute('aria-expanded', 'false');
    resultsBox.classList.remove('visible');
    resultsBox.innerHTML = '';
    searchInput.value = '';
    focusIdx = -1;
  }

  searchBtn.addEventListener('click', (e) => {
    e.stopPropagation();
    searchWrap.classList.contains('open') ? closeSearch() : openSearch();
  });

  function highlight(str, q) {
    if (!q) return str;
    const re = new RegExp('(' + q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
    return str.replace(re, '<mark>$1</mark>');
  }

  function runSearch(q) {
    q = q.trim().toLowerCase();
    resultsBox.innerHTML = '';
    focusIdx = -1;
    if (!q) { resultsBox.classList.remove('visible'); return; }

    const hits = SITE_INDEX.filter(item =>
      item.name.toLowerCase().includes(q) ||
      item.desc.toLowerCase().includes(q) ||
      item.tags.toLowerCase().includes(q)
    ).slice(0, 6);

    if (!hits.length) {
      resultsBox.innerHTML = '<div class="search-empty">No results for "' + q + '"</div>';
    } else {
      hits.forEach((item) => {
        const a = document.createElement('a');
        a.className = 'search-result-item';
        a.href = item.url;
        a.setAttribute('role', 'option');
        a.innerHTML =
          '<span class="sri-icon">' + item.icon + '</span>' +
          '<span class="sri-text">' +
            '<span class="sri-name">' + highlight(item.name, q) + '</span>' +
            '<span class="sri-desc">' + item.desc + '</span>' +
          '</span>';
        a.addEventListener('mousedown', (e) => { e.preventDefault(); window.location = item.url; });
        resultsBox.appendChild(a);
      });
    }
    resultsBox.classList.add('visible');
  }

  searchInput.addEventListener('input', () => runSearch(searchInput.value));
  searchInput.addEventListener('focus',  () => { if (searchInput.value.trim()) resultsBox.classList.add('visible'); });

  searchInput.addEventListener('keydown', (e) => {
    const items = resultsBox.querySelectorAll('.search-result-item');
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      focusIdx = Math.min(focusIdx + 1, items.length - 1);
      items.forEach((el, i) => el.classList.toggle('focused', i === focusIdx));
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      focusIdx = Math.max(focusIdx - 1, 0);
      items.forEach((el, i) => el.classList.toggle('focused', i === focusIdx));
    } else if (e.key === 'Enter') {
      e.preventDefault();
      if (focusIdx >= 0 && items[focusIdx]) window.location = items[focusIdx].href;
      else if (items.length === 1) window.location = items[0].href;
    } else if (e.key === 'Escape') {
      closeSearch();
    }
  });

  document.addEventListener('click', (e) => {
    if (!searchWrap.contains(e.target)) closeSearch();
  });
</script>
