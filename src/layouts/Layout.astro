---
import '../styles/global.css';
import { FEATURES } from '@data/config.ts';
import ConsentBanner from '@components/ConsentBanner.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: string;
  ogImage?: string;
}

const { title, description, canonical, ogType = 'website', ogImage = 'https://zippywidgets.online/ZippyWidgets%20Logo-1200.jpg' } = Astro.props;
const canonicalUrl = canonical || `https://zippywidgets.online${Astro.url.pathname.replace(/\/$/, '')}/`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#0f1117" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content={ogType} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="dns-prefetch" href="https://static.cloudflareinsights.com" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" />
  <link rel="stylesheet" href="/style.css" />
  <link rel="manifest" href="/manifest.json" />
  <script is:inline src="/theme.js"></script>
  <link rel="icon" type="image/png" href="/ZippyWidgets Logo-192.png" sizes="192x192" />
  <link rel="apple-touch-icon" href="/ZippyWidgets Logo-192.png" />
  <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
  <link rel="alternate" type="application/rss+xml" title="ZippyWidgets Blog RSS" href="/rss.xml" />
  {FEATURES.adsEnabled && <meta name="google-adsense-account" content="ca-pub-6884221059402072" />}
  <slot name="head" />
</head>
<body>
  <slot />
  {FEATURES.adsEnabled && <ConsentBanner />}
  <script type='module' src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "3a836cffee324682bf1554f0e4288871"}'></script>
</body>
</html>
