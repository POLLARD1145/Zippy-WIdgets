<section class="seo-section">
  <div class="seo-card">
    <h2>How to Play Emoji Memory Match</h2>
    <p>The board starts with all cards face-down. Tap any card to reveal the emoji hidden underneath. Then tap a second card — if the two emojis match, the pair stays face-up and glows green. If they don't match, both cards flip back over after a brief pause.</p>
    <p>Your goal is to find all pairs in as few flips as possible. The game tracks your flip count in real time. A lower score is better. Every day a new daily seed generates a fresh emoji set — the same set for every player worldwide.</p>
    <h3>Difficulty levels</h3>
    <p><strong>Easy (4×4 = 8 pairs)</strong> — great for a quick break or warming up your memory.<br><strong>Medium (4×5 = 10 pairs)</strong> — the default daily challenge.<br><strong>Hard (5×6 = 15 pairs)</strong> — tests your short-term memory under pressure.</p>
    <h3>Scoring &amp; streak</h3>
    <p>Your best flip count for each difficulty is saved in your browser (no account needed). Your daily play streak counts days in a row you complete the challenge — try to keep it going!</p>
  </div>
</section>
</main>



<script>
/* ════════════════════════════════════════════════════════════════
   EMOJI MEMORY MATCH — Game Logic
   Mobile-first. Daily seed via UTC date. No external deps.
════════════════════════════════════════════════════════════════ */

/* ── Seeded PRNG (mulberry32) ── */
function mulberry32(seed) {
  return function() {
    seed |= 0; seed = seed + 0x6D2B79F5 | 0;
    var t = Math.imul(seed ^ seed >>> 15, 1 | seed);
    t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
    return ((t ^ t >>> 14) >>> 0) / 4294967296;
  };
}

function todaySeed() {
  const d = new Date();
  return (d.getUTCFullYear() * 10000) + ((d.getUTCMonth() + 1) * 100) + d.getUTCDate();
}

/* Seeded shuffle — Fisher-Yates */
function shuffle(arr, rng) {
  const a = arr.slice();
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(rng() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

/* ── Emoji pool — 60 distinct, family-friendly ── */
const EMOJI_POOL = [
  '🐶','🐱','🐭','🐹','🐰','🦊','🐻','🐼','🐨','🐯',
  '🦁','🐮','🐷','🐸','🐵','🦄','🐙','🦋','🐢','🦕',
  '🌸','🌻','🌺','🍀','🌈','⭐','🌙','🔥','💎','🎈',
  '🎯','🎲','🎸','🎺','🎻','🥁','🎨','🖼️','🎭','🎪',
  '🍕','🍔','🍟','🌮','🍣','🍜','🍦','🎂','🍰','🍩',
  '🚀','🛸','🌍','🏔️','🏝️','🌋','🎠','🎡','🎢','🗽',
];

/* ── Difficulty config ── */
const DIFFS = {
  easy:   { pairs: 8,  cols: 4, label: 'Easy' },
  medium: { pairs: 10, cols: 4, label: 'Medium' },
  hard:   { pairs: 15, cols: 5, label: 'Hard' },
};

/* ── State ── */
let seed, rng, currentDiff, cards, flipped, matched, flips, locked, gameOver, startTime, playCount;

/* ── DOM refs ── */
const grid        = document.getElementById('cardGrid');
const msgBar      = document.getElementById('msgBar');
const statFlips   = document.getElementById('statFlips');
const statPairs   = document.getElementById('statPairs');
const statBest    = document.getElementById('statBest');
const statStreak  = document.getElementById('statStreak');
const resultCard  = document.getElementById('resultCard');
const resultEmoji = document.getElementById('resultEmoji');
const resultTitle = document.getElementById('resultTitle');
const resultDesc  = document.getElementById('resultDesc');
const bestRibbon  = document.getElementById('bestRibbon');
const newBestVal  = document.getElementById('newBestVal');
const shareBox    = document.getElementById('shareBox');
const dailySeedEl = document.getElementById('dailySeed');

/* ── Storage helpers ── */
function storageKey(diff, type) {
  return 'emm_' + seed + '_' + diff + '_' + type;
}
function globalKey(diff, type) {
  return 'emm_' + diff + '_' + type;
}
function getSaved(key, fallback) {
  try { const v = localStorage.getItem(key); return v !== null ? JSON.parse(v) : fallback; }
  catch(e) { return fallback; }
}
function setSaved(key, val) {
  try { localStorage.setItem(key, JSON.stringify(val)); } catch(e) {}
}

/* ── Init ── */
function init() {
  playCount = 0;
  seed = todaySeed();
  currentDiff = 'easy';
  updateSeedBadge();
  updateStreakDisplay();
  buildGame();
}

function updateSeedBadge() {
  dailySeedEl.textContent = playCount === 0
    ? seed + ' (daily)'
    : 'Bonus #' + playCount;
}

function buildGame(diff) {
  if (diff) currentDiff = diff;

  const cfg = DIFFS[currentDiff];
  rng   = mulberry32(seed + cfg.pairs); // diff-specific seed offset
  cards = [];
  flipped = [];
  matched = [];
  flips   = 0;
  locked  = false;
  gameOver = false;
  startTime = null;

  /* Pick emoji set for today's seed + difficulty */
  const emojiSet = shuffle(EMOJI_POOL, mulberry32(seed * 31 + cfg.pairs)).slice(0, cfg.pairs);

  /* Duplicate + shuffle to make pairs */
  const deck = shuffle([...emojiSet, ...emojiSet], rng);

  /* Update grid class for columns */
  grid.className = 'card-grid' + (cfg.cols === 5 ? ' grid-5' : '');
  grid.style.gridTemplateColumns = 'repeat(' + cfg.cols + ', 1fr)';

  /* Render */
  grid.innerHTML = '';
  deck.forEach((emoji, i) => {
    const card = document.createElement('button');
    card.className = 'mem-card';
    card.setAttribute('aria-label', 'Memory card ' + (i + 1));
    card.setAttribute('data-idx', i);
    card.innerHTML =
      '<div class="card-inner">' +
        '<div class="card-face card-back"></div>' +
        '<div class="card-face card-front">' + emoji + '</div>' +
      '</div>';
    card.addEventListener('click', () => onCardClick(card, emoji, i));
    cards.push({ el: card, emoji, matched: false });
    grid.appendChild(card);
  });

  /* Update stats */
  updateStats();
  setMsg('Tap any card to begin', '');

  /* Hide result */
  resultCard.classList.remove('visible');

  /* Show today's best */
  const best = getSaved(globalKey(currentDiff, 'best'), null);
  statBest.textContent = best !== null ? best : '—';
}

/* ── Card click ── */
function onCardClick(cardEl, emoji, idx) {
  if (locked || gameOver) return;
  if (cards[idx].matched) return;
  if (flipped.length === 1 && flipped[0].idx === idx) return; // same card

  /* Start timer on first flip */
  if (!startTime) startTime = Date.now();

  /* Flip it */
  cardEl.classList.add('flipped');
  flipped.push({ el: cardEl, emoji, idx });
  flips++;
  updateStats();
  playSound('tap');

  if (flipped.length === 2) {
    locked = true;
    const [a, b] = flipped;
    if (a.emoji === b.emoji) {
      /* Match! */
      playSound('correct');
      setTimeout(() => {
        a.el.classList.remove('flipped'); a.el.classList.add('matched');
        b.el.classList.remove('flipped'); b.el.classList.add('matched');
        cards[a.idx].matched = true;
        cards[b.idx].matched = true;
        matched.push(a.emoji);
        flipped = [];
        locked  = false;
        updateStats();

        const remaining = DIFFS[currentDiff].pairs - matched.length;
        if (remaining === 0) {
          onWin();
        } else {
          setMsg('✅ Match! ' + remaining + ' pair' + (remaining !== 1 ? 's' : '') + ' to go', 'good');
        }
      }, 250);
    } else {
      /* No match */
      playSound('wrong');
      setMsg('❌ No match — try again', 'bad');
      setTimeout(() => {
        a.el.classList.add('mismatch');
        b.el.classList.add('mismatch');
      }, 50);
      setTimeout(() => {
        a.el.classList.remove('flipped', 'mismatch');
        b.el.classList.remove('flipped', 'mismatch');
        flipped = [];
        locked  = false;
        setMsg('Keep going!', '');
      }, 900);
    }
  }
}

/* ── Win ── */
function onWin() {
  gameOver = true;
  playSound('win');
  const elapsed = startTime ? Math.round((Date.now() - startTime) / 1000) : 0;
  const cfg = DIFFS[currentDiff];
  const pairs = cfg.pairs;

  setMsg('🎉 You matched them all!', 'good');

  /* Best score */
  const bestKey = globalKey(currentDiff, 'best');
  const prevBest = getSaved(bestKey, null);
  const isNewBest = prevBest === null || flips < prevBest;
  if (isNewBest) {
    setSaved(bestKey, flips);
    statBest.textContent = flips;
    bestRibbon.style.display = 'flex';
    newBestVal.textContent = flips;
  } else {
    bestRibbon.style.display = 'none';
  }

  /* Save today's completion */
  setSaved(storageKey(currentDiff, 'done'), true);
  setSaved(storageKey(currentDiff, 'flips'), flips);

  /* Streak */
  updateStreak();
  updateStreakDisplay();

  /* Rating */
  const par = pairs * 2.5; // ideal ~2.5 flips per pair
  let rating, ratingEmoji;
  if (flips <= pairs * 2)      { rating = 'Perfect memory!';  ratingEmoji = '🧠'; }
  else if (flips <= par)       { rating = 'Excellent!';       ratingEmoji = '⭐'; }
  else if (flips <= par * 1.4) { rating = 'Good job!';        ratingEmoji = '🎯'; }
  else if (flips <= par * 1.9) { rating = 'Not bad!';         ratingEmoji = '👍'; }
  else                          { rating = 'Keep practising!'; ratingEmoji = '💪'; }

  resultEmoji.textContent = ratingEmoji;
  resultTitle.textContent = rating;
  resultDesc.textContent  =
    'You matched all ' + pairs + ' pairs in ' + flips + ' flips' +
    (elapsed ? ' (' + fmtTime(elapsed) + ')' : '') + '. ' +
    (isNewBest ? 'New personal best on ' + cfg.label + '!' : 'Your best is ' + prevBest + ' flips on ' + cfg.label + '.');

  /* Share text */
  const streakVal = getSaved('emm_streak', 0);
  const gridEmoji = buildShareGrid(pairs);
  const roundLabel = playCount === 0 ? seed + ' (daily)' : 'Bonus #' + playCount;
  shareBox.textContent =
    '🃏 Emoji Memory Match — ' + cfg.label + '\n' +
    '📅 ' + roundLabel + ' | ' + flips + ' flips\n' +
    (isNewBest ? '🏆 New best!\n' : '') +
    '🔥 Streak: ' + streakVal + ' day' + (streakVal !== 1 ? 's' : '') + '\n\n' +
    gridEmoji + '\n\n' +
    'zippywidgets.online/game/emoji-memory/';

  resultCard.classList.add('visible');
  resultCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

/* Build a compact share grid using coloured squares */
function buildShareGrid(pairs) {
  const total = pairs * 2;
  const cols  = DIFFS[currentDiff].cols;
  let out = '', count = 0;
  /* We use 🟩 for matched pairs.  We track order matches were found — for share we just show all green. */
  for (let i = 0; i < total; i++) {
    out += '🟩';
    count++;
    if (count % cols === 0 && i < total - 1) out += '\n';
  }
  return out;
}

/* ── Streak ── */
function updateStreak() {
  const today = seed;
  const yesterday = (() => {
    const d = new Date();
    d.setUTCDate(d.getUTCDate() - 1);
    return (d.getUTCFullYear() * 10000) + ((d.getUTCMonth() + 1) * 100) + d.getUTCDate();
  })();
  const lastDay  = getSaved('emm_last_day', null);
  let streak     = getSaved('emm_streak', 0);

  if (lastDay === today) return; // already counted today
  if (lastDay === yesterday) { streak++; }
  else { streak = 1; }

  setSaved('emm_streak', streak);
  setSaved('emm_last_day', today);
}

function updateStreakDisplay() {
  statStreak.textContent = getSaved('emm_streak', 0);
}

/* ── Helpers ── */
function setMsg(text, cls) {
  msgBar.textContent = text;
  msgBar.className = 'message-bar' + (cls ? ' ' + cls : '');
}

function updateStats() {
  statFlips.textContent  = flips;
  statPairs.textContent  = matched.length + '/' + DIFFS[currentDiff].pairs;
  const best = getSaved(globalKey(currentDiff, 'best'), null);
  statBest.textContent   = best !== null ? best : '—';
}

function fmtTime(s) {
  if (s < 60) return s + 's';
  return Math.floor(s / 60) + 'm ' + (s % 60) + 's';
}

/* ── Difficulty buttons ── */
document.querySelectorAll('.diff-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const pairsMap = { '8': 'easy', '10': 'medium', '15': 'hard' };
    const diff = pairsMap[btn.dataset.pairs];
    document.querySelectorAll('.diff-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    buildGame(diff);
  });
});

/* ── Play again ── */
document.getElementById('playAgainBtn').addEventListener('click', () => {
  playCount++;
  seed = todaySeed() + playCount * 999983;
  updateSeedBadge();
  buildGame();
});

/* ── Share ── */
document.getElementById('shareBtn').addEventListener('click', () => {
  const text = shareBox.textContent;
  if (navigator.share) {
    navigator.share({ title: 'Emoji Memory Match', text }).catch(() => copyFallback(text));
  } else {
    copyFallback(text);
  }
});
function copyFallback(text) {
  navigator.clipboard.writeText(text).then(() => {
    const btn = document.getElementById('shareBtn');
    btn.textContent = '✅ Copied!';
    setTimeout(() => btn.textContent = '📋 Copy Result', 1800);
  }).catch(() => {});
}

/* ── Hamburger nav ── */
const navToggle = document.getElementById('navToggle');
const navLinks  = document.getElementById('navLinks');
navToggle.addEventListener('click', () => {
  const open = navLinks.classList.toggle('open');
  navToggle.classList.toggle('open', open);
  navToggle.setAttribute('aria-expanded', open);
});
navLinks.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
  navLinks.classList.remove('open');
  navToggle.classList.remove('open');
  navToggle.setAttribute('aria-expanded', 'false');
}));

/* ── Boot ── */
init();
/* ── Audio engine ── */
let _audioCtx = null;
let _muted = (localStorage.getItem('zw_mute') === '1');
(function(){ document.getElementById('muteToggle').textContent = _muted ? '🔇' : '🔊'; })();

function _ctx() {
  if (!_audioCtx) _audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  return _audioCtx;
}
function _tone(freq, dur, type, vol) {
  if (_muted) return;
  try {
    const c = _ctx(), o = c.createOscillator(), g = c.createGain();
    o.connect(g); g.connect(c.destination);
    o.type = type || 'sine'; o.frequency.value = freq;
    g.gain.setValueAtTime(vol || 0.22, c.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, c.currentTime + dur);
    o.start(); o.stop(c.currentTime + dur);
  } catch(e){}
}
function playSound(name) {
  if (_muted) return;
  if (name === 'tap')     { _tone(380, 0.06, 'sine', 0.1); }
  if (name === 'correct') { _tone(520, 0.08, 'sine'); setTimeout(() => _tone(780, 0.14, 'sine'), 80); }
  if (name === 'wrong')   { _tone(180, 0.15, 'sawtooth', 0.16); }
  if (name === 'win') {
    [523,659,784,1047].forEach((f,i) => setTimeout(() => _tone(f, 0.15, 'sine', 0.2), i*80));
  }
}
function toggleMute() {
  _muted = !_muted;
  localStorage.setItem('zw_mute', _muted ? '1' : '0');
  document.getElementById('muteToggle').textContent = _muted ? '🔇' : '🔊';
}
</script>

