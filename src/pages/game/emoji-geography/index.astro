const MAX_SCORE = QUESTIONS_PER_ROUND * STARS_PER_Q;

/* ── State ── */
let seed, rng, questions, qIdx, answers, currentStars, hintUsed, answered, score, playCount;

/* ── DOM refs ── */
const flagDisplay   = document.getElementById('flagDisplay');
const starsRow      = document.getElementById('starsRow');
const optionsGrid   = document.getElementById('optionsGrid');
const hintBtn       = document.getElementById('hintBtn');
const hintText      = document.getElementById('hintText');
const feedbackBar   = document.getElementById('feedbackBar');
const nextBtn       = document.getElementById('nextBtn');
const progressFill  = document.getElementById('progressFill');
const progressLabel = document.getElementById('progressLabel');
const scoreLabel    = document.getElementById('scoreLabel');
const pipRow        = document.getElementById('pipRow');
const resultCard    = document.getElementById('resultCard');
const dailySeedEl   = document.getElementById('dailySeed');

/* ── Storage helpers ── */
function getSaved(key, fb) { try { const v=localStorage.getItem(key); return v!==null?JSON.parse(v):fb; } catch(e){return fb;} }
function setSaved(key, val){ try { localStorage.setItem(key,JSON.stringify(val)); } catch(e){} }

/* ── Boot ── */
function init() {
  playCount = 0;
  seed = todaySeed();
  dailySeedEl.textContent = seed;
  updateSeedBadge();
  buildRound();
  updateStreakDisplay();
}

function updateSeedBadge() {
  dailySeedEl.textContent = playCount === 0
    ? seed + ' (daily)'
    : 'Bonus #' + playCount;
}

function buildRound() {
  rng       = mulberry32(seed);
  answers   = [];
  qIdx      = 0;
  score     = 0;

  /* Pick 10 countries for today */
  const shuffled = shuffle(COUNTRIES, mulberry32(seed * 7));
  questions = shuffled.slice(0, QUESTIONS_PER_ROUND).map(c => {
    /* Pick 3 distractors from the remaining pool */
    const distractors = shuffle(
      COUNTRIES.filter(x => x[1] !== c[1]),
      mulberry32(seed + c[1].charCodeAt(0))
    ).slice(0, DISTRACTORS_COUNT).map(x => x[1]);
    const options = shuffle([c[1], ...distractors], mulberry32(seed ^ c[1].charCodeAt(0)));
    return { flag: c[0], name: c[1], continent: c[2], capital: c[3], hint: c[4], options };
  });

  /* Build pip row */
  pipRow.innerHTML = '';
  questions.forEach((_, i) => {
    const pip = document.createElement('div');
    pip.className = 'q-pip' + (i === 0 ? ' active' : '');
    pip.id = 'pip-' + i;
    pip.textContent = i + 1;
    pipRow.appendChild(pip);
  });

  resultCard.classList.remove('visible');
  renderQuestion();
}

/* ── Render question ── */
function renderQuestion() {
  const q = questions[qIdx];
  currentStars = STARS_PER_Q;
  hintUsed     = false;
  answered     = false;

  flagDisplay.textContent = q.flag;
  updateStars(currentStars);
  hintText.textContent    = '';
  hintBtn.disabled        = false;
  setFeedback('', 'empty');
  nextBtn.classList.remove('visible');

  progressLabel.textContent = 'Question ' + (qIdx+1) + ' of ' + QUESTIONS_PER_ROUND;
  progressFill.style.width  = (qIdx / QUESTIONS_PER_ROUND * 100) + '%';
  scoreLabel.textContent    = '⭐ ' + score + ' pts';

  /* Options */
  optionsGrid.innerHTML = '';
  q.options.forEach(name => {
    const btn = document.createElement('button');
    btn.className   = 'option-btn';
    btn.textContent = name;
    btn.addEventListener('click', () => onAnswer(name, btn));
    optionsGrid.appendChild(btn);
  });
}

/* ── Answer ── */
function onAnswer(name, btn) {
  if (answered) return;
  const q = questions[qIdx];

  if (name === q.name) {
    /* Correct */
    answered = true;
    btn.classList.add('correct');
    playSound('correct');
    /* Reveal correct if they had a wrong guess before — not applicable on first correct */
    /* Disable all */
    optionsGrid.querySelectorAll('.option-btn').forEach(b => b.disabled = true);

    const earned = currentStars;
    score += earned;
    answers.push({ q, stars: earned, correct: true });

    const msgs = ['🎉 Correct!', '✅ Well done!', '🌍 Right answer!', '⭐ Spot on!'];
    setFeedback(msgs[Math.floor(rng() * msgs.length)] + ' +' + earned + '⭐', 'good');
    updatePip(qIdx, 'correct');
    nextBtn.classList.add('visible');

  } else {
    /* Wrong */
    playSound('wrong');
    btn.classList.add('wrong');
    btn.disabled = true;
    currentStars = Math.max(currentStars - 1, 0);
    updateStars(currentStars);

    if (currentStars === 0) {
      /* Out of stars — reveal answer */
      answered = true;
      optionsGrid.querySelectorAll('.option-btn').forEach(b => {
        b.disabled = true;
        if (b.textContent === q.name) b.classList.add('reveal');
      });
      answers.push({ q, stars: 0, correct: false });
      setFeedback('❌ It was ' + q.flag + ' ' + q.name, 'bad');
      updatePip(qIdx, 'wrong');
      nextBtn.classList.add('visible');
    } else {
      setFeedback('❌ Not quite — try again!', 'bad');
    }
  }

  scoreLabel.textContent = '⭐ ' + score + ' pts';
}

/* ── Hint ── */
hintBtn.addEventListener('click', () => {
  if (answered || hintUsed) return;
  hintUsed = true;
  currentStars = Math.max(currentStars - 1, 1); /* min 1 star if using hint */
  updateStars(currentStars);
  hintBtn.disabled = true;
  const q = questions[qIdx];
  hintText.textContent = '💡 ' + q.continent + ' · Capital: ' + q.capital + ' · ' + q.hint;
});

/* ── Next ── */
nextBtn.addEventListener('click', () => {
  qIdx++;
  if (qIdx >= QUESTIONS_PER_ROUND) {
    showResult();
  } else {
    updatePip(qIdx, 'active');
    renderQuestion();
  }
});

/* ── Result ── */
function showResult() {
  progressFill.style.width = '100%';
  progressLabel.textContent = 'Complete!';
  scoreLabel.textContent = '⭐ ' + score + ' pts';

  /* Streak */
  updateStreak();
  updateStreakDisplay();
  const streak = getSaved('eg_streak', 0);

  /* Trophy & title */
  const pct = score / MAX_SCORE;
  let trophy, title, desc;
  if (pct === 1)       { trophy='🏆'; title='Perfect score!';      desc='Flawless — a true geography expert!'; }
  else if (pct >= .8)  { trophy='🥇'; title='Excellent!';          desc='You really know your flags!'; }
  else if (pct >= .6)  { trophy='🥈'; title='Good job!';           desc='Solid geography knowledge!'; }
  else if (pct >= .4)  { trophy='🥉'; title='Not bad!';            desc='Keep exploring the world!'; }
  else                  { trophy='🌍'; title='Keep learning!';      desc='The world is big — come back tomorrow!'; }

  document.getElementById('resultTrophy').textContent = trophy;
  document.getElementById('resultTitle').textContent  = title;
  document.getElementById('resultScore').textContent  = score + ' / ' + MAX_SCORE;
  document.getElementById('resultDesc').textContent   = desc;
  document.getElementById('streakVal').textContent    = streak;
  document.getElementById('streakRibbon').lastChild.textContent = streak + ' day' + (streak !== 1 ? 's' : '');

  /* Stars display */
  const totalStarsEarned = answers.reduce((a,x)=>a+x.stars,0);
  const maxStars = QUESTIONS_PER_ROUND * STARS_PER_Q;
  document.getElementById('resultStars').textContent = '⭐'.repeat(Math.round(totalStarsEarned / maxStars * 5));

  /* Share text */
  const gridLines = answers.map(a => {
    if (a.stars === 3) return '🟩🟩🟩';
    if (a.stars === 2) return '🟨🟩🟩';
    if (a.stars === 1) return '🟥🟩⬜';
    return '🟥🟥🟥';
  });
  const roundLabel = playCount === 0 ? seed + ' (daily)' : 'Bonus #' + playCount;
  document.getElementById('shareBox').textContent =
    '🌍 Emoji Geography — ' + roundLabel + '\n' +
    '⭐ ' + score + '/' + MAX_SCORE + ' pts\n' +
    '🔥 Streak: ' + streak + ' day' + (streak !== 1 ? 's' : '') + '\n\n' +
    gridLines.join('\n') + '\n\n' +
    'zippywidgets.online/game/emoji-geography/';

  /* Review list */
  const reviewList = document.getElementById('reviewList');
  reviewList.innerHTML = '<div style="font-size:.78rem;color:var(--muted);text-align:center;margin-bottom:.25rem;">Your answers</div>';
  answers.forEach(a => {
    const item = document.createElement('div');
    item.className = 'review-item';
    item.innerHTML =
      '<span class="review-flag">' + a.q.flag + '</span>' +
      '<span class="review-text"><span class="review-country">' + a.q.name + '</span></span>' +
      '<span class="review-stars">' + '⭐'.repeat(a.stars) + (a.stars===0?'❌':'') + '</span>';
    reviewList.appendChild(item);
  });

  resultCard.classList.add('visible');
  resultCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

/* ── Streak ── */
function updateStreak() {
  const today = seed;
  const yesterday = (() => {
    const d = new Date(); d.setUTCDate(d.getUTCDate()-1);
    return (d.getUTCFullYear()*10000)+((d.getUTCMonth()+1)*100)+d.getUTCDate();
  })();
  const lastDay = getSaved('eg_last_day', null);
  if (lastDay === today) return;
  let streak = getSaved('eg_streak', 0);
  streak = (lastDay === yesterday) ? streak + 1 : 1;
  setSaved('eg_streak', streak);
  setSaved('eg_last_day', today);
}
function updateStreakDisplay() {
  const streak = getSaved('eg_streak', 0);
  if (document.getElementById('streakVal')) document.getElementById('streakVal').textContent = streak;
}

/* ── UI helpers ── */
function updateStars(n) {
  starsRow.textContent = '⭐'.repeat(n) + '☆'.repeat(STARS_PER_Q - n);
}
function setFeedback(text, cls) {
  feedbackBar.textContent = text;
  feedbackBar.className = 'feedback-bar ' + cls;
}
function updatePip(idx, state) {
  const pip = document.getElementById('pip-' + idx);
  if (!pip) return;
  pip.className = 'q-pip ' + state;
  pip.textContent = state === 'correct' ? '✓' : state === 'wrong' ? '✗' : (idx+1);
}

/* ── Play again ── */
document.getElementById('playAgainBtn').addEventListener('click', () => {
  playCount++;
  /* New seed each replay — different from daily, different from previous replays */
  seed = todaySeed() + playCount * 999983;
  updateSeedBadge();
  resultCard.classList.remove('visible');
  buildRound();
});

/* ── Share ── */
document.getElementById('shareBtn').addEventListener('click', () => {
  const text = document.getElementById('shareBox').textContent;
  if (navigator.share) {
    navigator.share({ title: 'Emoji Geography', text }).catch(() => copyFallback(text));
  } else { copyFallback(text); }
});
function copyFallback(text) {
  navigator.clipboard.writeText(text).then(() => {
    const btn = document.getElementById('shareBtn');
    btn.textContent = '✅ Copied!';
    setTimeout(() => btn.textContent = '📋 Copy Result', 1800);
  }).catch(()=>{});
}

/* ── Hamburger nav ── */
const navToggle = document.getElementById('navToggle');
const navLinks  = document.getElementById('navLinks');
navToggle.addEventListener('click', () => {
  const open = navLinks.classList.toggle('open');
  navToggle.classList.toggle('open', open);
  navToggle.setAttribute('aria-expanded', open);
});
navLinks.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
  navLinks.classList.remove('open');
  navToggle.classList.remove('open');
  navToggle.setAttribute('aria-expanded', 'false');
}));

/* ── Audio engine ── */
let _audioCtx = null;
let _muted = (localStorage.getItem('zw_mute') === '1');
(function(){ document.getElementById('muteToggle').textContent = _muted ? '🔇' : '🔊'; })();

function _ctx() {
  if (!_audioCtx) _audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  return _audioCtx;
}
function _tone(freq, dur, type, vol) {
  if (_muted) return;
  try {
    const c = _ctx(), o = c.createOscillator(), g = c.createGain();
    o.connect(g); g.connect(c.destination);
    o.type = type || 'sine'; o.frequency.value = freq;
    g.gain.setValueAtTime(vol || 0.22, c.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001, c.currentTime + dur);
    o.start(); o.stop(c.currentTime + dur);
  } catch(e){}
}
function playSound(name) {
  if (_muted) return;
  if (name === 'correct') { _tone(520, 0.08, 'sine'); setTimeout(() => _tone(780, 0.14, 'sine'), 80); }
  if (name === 'wrong')   { _tone(200, 0.12, 'sawtooth', 0.16); }
  if (name === 'win') {
    [523,659,784,1047].forEach((f,i) => setTimeout(() => _tone(f, 0.15, 'sine', 0.2), i*80));
  }
}
function toggleMute() {
  _muted = !_muted;
  localStorage.setItem('zw_mute', _muted ? '1' : '0');
  document.getElementById('muteToggle').textContent = _muted ? '🔇' : '🔊';
}

/* ── Boot ── */
init();
</script>

