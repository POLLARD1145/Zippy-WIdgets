---
import Layout from '@layouts/Layout.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import BreadcrumbSchema from '@components/BreadcrumbSchema.astro';

const title = 'Daily Wordle — Free Word Guessing Game Online (No Login) | ZippyWidgets';
const description = 'Guess the hidden 5-letter word in 6 tries. Free daily Wordle-style game — no login required. Same word worldwide every day. Green, yellow and grey clues guide your guesses!';
const canonical = 'https://zippywidgets.online/game/wordle/';
---

<Layout title={title} description={description} canonical={canonical}>
  <Fragment slot="head">
    <BreadcrumbSchema items={[
      { name: 'Home', item: 'https://zippywidgets.online/' },
      { name: 'Games', item: 'https://zippywidgets.online/game/' },
      { name: 'Daily Wordle', item: 'https://zippywidgets.online/game/wordle/' },
    ]} />
    <meta name="keywords" content="wordle game, free wordle, daily wordle, word guessing game, wordle online, 5 letter word game, wordle no login, wordle today" />
    <meta property="og:title" content="Daily Wordle — Free Word Guessing Game (No Login)" />
    <meta property="og:description" content="Guess the 5-letter word in 6 tries. Free daily wordle-style game — no signup. Same word worldwide every day." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://zippywidgets.online/ZippyWidgets Logo.png" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Daily Wordle — Free Word Guessing Game No Login" />
    <meta name="twitter:description" content="Free wordle-style game — guess the 5-letter word in 6 tries. No signup. Same puzzle worldwide." />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "VideoGame",
        "name": "Daily Wordle",
        "description": "A free daily word guessing game. Players have 6 attempts to guess a hidden 5-letter word using colour-coded clues. Same puzzle worldwide every day.",
        "url": "https://zippywidgets.online/game/wordle/",
        "applicationCategory": "Game",
        "gamePlatform": "Web Browser",
        "genre": ["Word Game", "Puzzle"],
        "playMode": "SinglePlayer",
        "publisher": { "@type": "Organization", "name": "ZippyWidgets", "url": "https://zippywidgets.online/" },
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
      }
    </script>
  </Fragment>

  <Nav />

  <!-- Top ad — deferred until first interaction -->
  <div class="ad-slot-game" id="ad-top-wl" style="padding:.25rem 1rem;">
    <ins class="adsbygoogle" style="display:block"
      data-ad-client="ca-pub-6884221059402072"
      data-ad-slot="auto" data-ad-format="horizontal"
      data-full-width-responsive="true"></ins>
  </div>

  <main>
  <div class="game-page">

    <!-- Header -->
    <div class="game-header">
      <h1 class="game-title">Daily <span>Wordle</span></h1>
      <div style="display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;justify-content:center;">
        <div class="seed-badge">🌐 Puzzle <b id="seed-display">—</b></div>
        <span class="mode-label" id="mode-label">📅 Daily puzzle</span>
      </div>
      <!-- already-played notice, hidden by default -->
      <div class="daily-done-notice" id="daily-done-notice" style="display:none;">
        ✅ You already completed today's puzzle — here's a bonus round!
      </div>
      <!-- attempt dots -->
      <div class="attempt-dots" id="attempt-dots">
        <div class="attempt-dot active" id="dot-0"></div>
        <div class="attempt-dot" id="dot-1"></div>
        <div class="attempt-dot" id="dot-2"></div>
        <div class="attempt-dot" id="dot-3"></div>
        <div class="attempt-dot" id="dot-4"></div>
        <div class="attempt-dot" id="dot-5"></div>
      </div>
    </div>

    <!-- Message bar -->
    <div class="message-bar" id="message-bar">Guess the 5-letter word</div>

    <!-- Guess grid -->
    <div class="guess-grid" id="guess-grid"></div>

    <!-- Keyboard -->
    <div class="keyboard" id="keyboard">
      <div class="kb-row" id="kb-row-0"></div>
      <div class="kb-row" id="kb-row-1"></div>
      <div class="kb-row" id="kb-row-2"></div>
    </div>

  </div>

  <!-- Result modal overlay -->
  <div class="modal-backdrop" id="result-modal" aria-modal="true" role="dialog" aria-labelledby="result-heading" style="display:none;">
    <div class="modal-panel">
      <div class="result-emoji" id="result-emoji">🎉</div>
      <h2 id="result-heading">—</h2>
      <p id="result-body">—</p>
      <div class="share-box" id="share-box"></div>
      <div class="btn-row">
        <button class="btn btn-primary" onclick="copyShare()">📋 Copy Result</button>
        <button class="btn btn-primary" id="btn-play-again" onclick="playBonus()" style="background:linear-gradient(135deg,#4ade80,#38bdf8);color:#000;">🎲 Play Again</button>
        <button class="btn btn-secondary" onclick="window.location.href='/game/'">🎮 More Games</button>
      </div>
    </div>
  </div>

  <!-- SEO section -->
  <div class="game-page seo-section" style="padding-top:0;">
    <div class="seo-card">
      <h2>How to Play Daily Wordle</h2>
      <p>Guess the hidden <strong style="color:var(--text);">5-letter word</strong> in 6 attempts. Type a word and press Enter. After each guess the tiles change colour to show how close you are.</p>
      <h3>Colour Clues</h3>
      <ul style="padding-left:1.1rem;display:flex;flex-direction:column;gap:.3rem;">
        <li><strong style="color:#4ade80;">Green</strong> — correct letter, correct position</li>
        <li><strong style="color:#fbbf24;">Yellow</strong> — letter is in the word but wrong position</li>
        <li><strong style="color:#555;">Grey</strong> — letter not in the word at all</li>
      </ul>
      <p>A new puzzle resets every day at midnight UTC. Share your spoiler-free emoji result with friends to compare without giving away the answer.</p>
    </div>
    <div class="seo-card">
      <h2>Frequently Asked Questions</h2>
      <div style="display:flex;flex-direction:column;gap:.9rem;">
        <div><h3>Is this free to play?</h3><p>Yes — completely free, no login or sign-up required.</p></div>
        <div><h3>Does every player get the same word?</h3><p>Yes. The daily word is chosen using today's UTC date as a seed, so every player worldwide has the same puzzle.</p></div>
        <div><h3>Do only valid words count?</h3><p>Yes — your guess must be a real English word from our dictionary. Made-up letter strings won't be accepted.</p></div>
        <div><h3>Is my progress saved?</h3><p>Yes — your game state is saved in your browser's localStorage so you can close the tab and return.</p></div>
        <div><h3>Can I play extra rounds after the daily?</h3><p>Yes — after finishing the daily you can keep playing unlimited bonus rounds with the Play Again button.</p></div>
      </div>
    </div>
    <p style="text-align:center;font-size:.8rem;color:var(--muted);">← <a href="/game/" style="color:#38bdf8;">All Games</a> &nbsp;·&nbsp; <a href="/" style="color:#38bdf8;">ZippyWidgets</a></p>
    <div class="ad-slot-game" id="ad-bottom-wl">
      <ins class="adsbygoogle" style="display:block"
        data-ad-client="ca-pub-6884221059402072"
        data-ad-slot="auto" data-ad-format="auto"
        data-full-width-responsive="true"></ins>
    </div>
  </div>
  </main>


  <script is:inline>
"use strict";

// ── PRNG (Mulberry32) ────────────────────────────────────────────────────
function seededRandom(seed) {
  return function() {
    let t = seed += 0x6D2B79F5;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
function getDailySeed() {
  const p = new URLSearchParams(window.location.search);
  if (p.has('seed')) return parseInt(p.get('seed'), 10);
  const d = new Date();
  return (d.getUTCFullYear() * 10000) + ((d.getUTCMonth() + 1) * 100) + d.getUTCDate();
}

