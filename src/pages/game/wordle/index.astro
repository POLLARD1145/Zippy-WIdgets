const VALID_WORDS = new Set([...ANSWERS, ...VALID_EXTRA]);

// ── Game state ────────────────────────────────────────────────────────────
const DAILY_SEED = getDailySeed();
const WORD_LEN = 5;
const MAX_ATTEMPTS = 6;
const KB_ROWS = [
  ['Q','W','E','R','T','Y','U','I','O','P'],
  ['A','S','D','F','G','H','J','K','L'],
