let isBonus = false;
let bonusRound = 0;
let TARGET_WORD, SAVE_KEY;
let guesses, currentRow, currentInput, gameOver, keyStates;

// ── Pick word ────────────────────────────────────────────────────────────
function pickAnswer(seed) {
  const rng = seededRandom(seed);
  return ANSWERS[Math.floor(rng() * ANSWERS.length)];
}

// ── Helper: check if a save slot is already finished ─────────────────────
function isSaveFinished(key) {
  try {
    const raw = localStorage.getItem(key);
    if (!raw) return false;
    return JSON.parse(raw).gameOver === true;
  } catch { return false; }
}

// ── Init ──────────────────────────────────────────────────────────────────
function initRound(bonus, bRound) {
  // If the requested slot is already finished, find the next fresh bonus round
  let resolvedBonus = bonus;
  let resolvedRound = bRound;
  const dailyKey = `wl_daily_${DAILY_SEED}`;

  if (!bonus && isSaveFinished(dailyKey)) {
    // Daily is done — scan forward to find the first unplayed bonus slot
    resolvedBonus = true;
    resolvedRound = 1;
    while (isSaveFinished(`wl_bonus_${DAILY_SEED}_${resolvedRound}`)) {
      resolvedRound++;
    }
  } else if (bonus && isSaveFinished(`wl_bonus_${DAILY_SEED}_${bRound}`)) {
    // A specific bonus round is done (e.g. Play Again on an already-solved bonus)
    resolvedRound = bRound + 1;
    while (isSaveFinished(`wl_bonus_${DAILY_SEED}_${resolvedRound}`)) {
      resolvedRound++;
    }
  }

  isBonus = resolvedBonus;
  bonusRound = resolvedRound;
  const seed = resolvedBonus
    ? DAILY_SEED * 1000 + resolvedRound * 13
    : DAILY_SEED;
  TARGET_WORD = pickAnswer(seed);
  SAVE_KEY = resolvedBonus
    ? `wl_bonus_${DAILY_SEED}_${resolvedRound}`
    : dailyKey;

  // Reset state, then load any in-progress save for this slot
  guesses = [];
  currentRow = 0;
  currentInput = '';
  gameOver = false;
  keyStates = {};
  loadState(); // safe — we only reach here if the slot is NOT finished

  renderAll();
  updateModeLabel();
  document.getElementById('seed-display').textContent = resolvedBonus ? `Bonus ${resolvedRound}` : DAILY_SEED;

  // Show notice when we auto-skipped the daily
  const notice = document.getElementById('daily-done-notice');
  if (notice) {
    const dailyWasDone = !bonus && resolvedBonus;
    notice.style.display = dailyWasDone ? '' : 'none';
  }

  if (currentRow > 0) {
    setMessage(`${MAX_ATTEMPTS - currentRow} attempt${MAX_ATTEMPTS - currentRow > 1 ? 's' : ''} left`, 'info');
  } else {
    setMessage('Guess the 5-letter word');
  }
}

// ── Render ────────────────────────────────────────────────────────────────
function closeModal() {
  const modal = document.getElementById('result-modal');
  modal.classList.remove('open');
  setTimeout(() => { modal.style.display = 'none'; }, 250);
}
function openModal() {
  const modal = document.getElementById('result-modal');
  modal.style.display = 'flex';
  requestAnimationFrame(() => modal.classList.add('open'));
}

function renderAll() {
  renderGrid();
  renderKeyboard();
  closeModal();
  document.getElementById('keyboard').style.opacity = '';
  document.getElementById('keyboard').style.pointerEvents = '';
  // dots
  for (let i = 0; i < MAX_ATTEMPTS; i++) {
    const dot = document.getElementById('dot-' + i);
    if (!dot) continue;
    dot.className = 'attempt-dot';
  }
  guesses.forEach((g, i) => {
    const dot = document.getElementById('dot-' + i);
    if (dot) dot.classList.add(g === TARGET_WORD ? 'correct' : 'wrong');
  });
  if (!gameOver && currentRow < MAX_ATTEMPTS) {
    const d = document.getElementById('dot-' + currentRow);
    if (d) d.classList.add('active');
  }
}

function renderGrid() {
  const grid = document.getElementById('guess-grid');
  grid.innerHTML = '';
  for (let r = 0; r < MAX_ATTEMPTS; r++) {
    const row = document.createElement('div');
    row.className = 'guess-row';
    row.id = 'row-' + r;
    for (let c = 0; c < WORD_LEN; c++) {
      const tile = document.createElement('div');
      tile.className = 'g-tile';
      tile.id = `tile-${r}-${c}`;
      if (r < guesses.length) {
        tile.textContent = guesses[r][c];
        tile.classList.add(getTileClass(guesses[r], c));
      } else if (r === currentRow) {
        tile.textContent = currentInput[c] || '';
        if (c === currentInput.length && !gameOver) tile.classList.add('active-cur');
      }
      row.appendChild(tile);
    }
    grid.appendChild(row);
  }
}

function getTileClass(word, col) {
  const ch = word[col];
  if (ch === TARGET_WORD[col]) return 'correct';
  // count available letters for yellow logic
  const targetArr = TARGET_WORD.split('');
  const guessArr = word.split('');
  // mark greens first
  const used = targetArr.map((t, i) => guessArr[i] === t);
  // count yellows
  let yellows = 0;
  for (let i = 0; i < col; i++) {
    if (guessArr[i] !== TARGET_WORD[i] && TARGET_WORD.includes(guessArr[i])) yellows++;
  }
  const totalInTarget = targetArr.filter(t => t === ch).length;
  const greensOfCh = targetArr.filter((t, i) => t === ch && guessArr[i] === ch).length;
  const priorYellows = guessArr.slice(0, col).filter((g, i) => g === ch && g !== targetArr[i]).length;
  if (TARGET_WORD.includes(ch) && greensOfCh + priorYellows < totalInTarget) return 'present';
  return 'absent';
}

function renderKeyboard() {
  KB_ROWS.forEach((keys, ri) => {
    const rowEl = document.getElementById('kb-row-' + ri);
    rowEl.innerHTML = '';
    keys.forEach(k => {
      const btn = document.createElement('button');
      btn.className = 'kb-key' + (k.length > 1 ? ' wide' : '');
      btn.textContent = k;
      btn.dataset.key = k;
      const state = keyStates[k];
      if (state) btn.classList.add(state);
      btn.addEventListener('click', () => handleKey(k));
      rowEl.appendChild(btn);
    });
  });
}

function updateKeyboard() {
  KB_ROWS.flat().forEach(k => {
    const el = document.querySelector(`.kb-key[data-key="${k}"]`);
    if (!el) return;
    const state = keyStates[k];
    el.className = 'kb-key' + (k.length > 1 ? ' wide' : '') + (state ? ' ' + state : '');
  });
}

function setMessage(msg, cls = '') {
  const el = document.getElementById('message-bar');
  el.textContent = msg;
  el.className = 'message-bar' + (cls ? ' ' + cls : '');
}
function updateModeLabel() {
  const el = document.getElementById('mode-label');
  if (!el) return;
  el.textContent = isBonus ? `🎲 Bonus round ${bonusRound}` : '📅 Daily puzzle';
  el.style.color = isBonus ? 'var(--yellow)' : 'var(--accent)';
}

// ── Input ─────────────────────────────────────────────────────────────────
function handleKey(key) {
  if (gameOver) return;
  if (key === '⌫' || key === 'BACKSPACE') {
    currentInput = currentInput.slice(0, -1);
    setMessage('Guess the 5-letter word');
    renderGrid();
    return;
  }
  if (key === 'ENTER') { submitGuess(); return; }
  if (/^[A-Z]$/.test(key) && currentInput.length < WORD_LEN) {
    currentInput += key;
    renderGrid();
    playSound('tap');
  }
}
document.addEventListener('keydown', e => {
  if (e.ctrlKey || e.metaKey || e.altKey) return;
  const k = e.key.toUpperCase();
  if (k === 'BACKSPACE') { handleKey('⌫'); return; }
  if (k === 'ENTER') { handleKey('ENTER'); return; }
  if (/^[A-Z]$/.test(k)) handleKey(k);
});

// ── Submit ────────────────────────────────────────────────────────────────
function submitGuess() {
  if (currentInput.length < WORD_LEN) {
    setMessage('Not enough letters', 'bad');
    shakeRow(currentRow);
    playSound('wrong');
    return;
  }
  if (!VALID_WORDS.has(currentInput)) {
    setMessage('Not in word list', 'bad');
    shakeRow(currentRow);
    playSound('wrong');
    return;
  }
  const guess = currentInput;
  guesses.push(guess);
  // update key states
  guess.split('').forEach((ch, i) => {
    const newState = getTileClass(guess, i);
    const cur = keyStates[ch];
    if (!cur || (cur === 'absent') || (cur === 'present' && newState === 'correct')) {
      keyStates[ch] = newState;
    }
  });
  currentInput = '';
  currentRow++;
  renderGrid();
  updateKeyboard();
  flipRow(currentRow - 1);
  if (guess === TARGET_WORD) {
    gameOver = true;
    updateDots(currentRow - 1, 'correct');
    saveState();
    playSound('correct');
    setTimeout(() => { playSound('win'); showResult(true); }, 600);
    return;
  }
  if (currentRow >= MAX_ATTEMPTS) {
    gameOver = true;
    updateDots(currentRow - 1, 'wrong');
    saveState();
    playSound('wrong');
    setTimeout(() => { playSound('lose'); showResult(false); }, 600);
    return;
  }
  updateDots(currentRow - 1, 'wrong');
  playSound('wrong');
  saveState();
  setMessage(`${MAX_ATTEMPTS - currentRow} attempt${MAX_ATTEMPTS - currentRow > 1 ? 's' : ''} left`, 'info');
}

function updateDots(idx, result) {
  const dot = document.getElementById('dot-' + idx);
  if (dot) { dot.classList.remove('active'); dot.classList.add(result); }
  const next = document.getElementById('dot-' + (idx + 1));
  if (next) next.classList.add('active');
}

// ── Animations ────────────────────────────────────────────────────────────
function shakeRow(r) {
  const row = document.getElementById('row-' + r);
  if (!row) return;
  row.style.animation = 'none';
  row.offsetHeight;
  row.style.animation = 'shake .4s ease';
}
function flipRow(r) {
  for (let c = 0; c < WORD_LEN; c++) {
    const tile = document.getElementById(`tile-${r}-${c}`);
    if (!tile) continue;
    setTimeout(() => {
      tile.style.transform = 'rotateX(90deg)';
      setTimeout(() => { tile.style.transform = ''; }, 150);
    }, c * 80);
  }
}
const styleEl = document.createElement('style');
styleEl.textContent = `@keyframes shake { 0%,100%{transform:translateX(0)} 20%,60%{transform:translateX(-6px)} 40%,80%{transform:translateX(6px)} }`;
document.head.appendChild(styleEl);

// ── Result ────────────────────────────────────────────────────────────────
const RESULT_EMOJIS = ['🏆','🌟','🎯','👍','😅','😬'];
function buildShareText(won) {
  const d = new Date();
  const ds = `${d.getUTCFullYear()}-${String(d.getUTCMonth()+1).padStart(2,'0')}-${String(d.getUTCDate()).padStart(2,'0')}`;
  const label = isBonus ? `ZippyWidgets Bonus Wordle (round ${bonusRound})` : `ZippyWidgets Daily Wordle ${ds}`;
  let grid = label + '\n';
  grid += (won ? `${guesses.length}/${MAX_ATTEMPTS}` : `X/${MAX_ATTEMPTS}`) + '\n\n';
  guesses.forEach(g => {
    grid += g.split('').map((ch, i) => {
      if (ch === TARGET_WORD[i]) return '🟩';
      if (TARGET_WORD.includes(ch)) return '🟨';
      return '⬛';
    }).join('') + '\n';
  });
  return (grid + '\nplay: zippywidgets.online/game/wordle/').trim();
}
function showResult(won) {
  document.getElementById('result-emoji').textContent = won ? RESULT_EMOJIS[Math.min(guesses.length - 1, 5)] : '💀';
  document.getElementById('result-heading').textContent = won ? `Solved in ${guesses.length}!` : `The word was ${TARGET_WORD}`;
  document.getElementById('result-body').textContent = won
    ? `You got "${TARGET_WORD}" in ${guesses.length} of ${MAX_ATTEMPTS} guesses.`
    : `The answer was "${TARGET_WORD}". Better luck tomorrow!`;
  document.getElementById('share-box').textContent = buildShareText(won);
  setMessage(won ? '🎉 Nicely done!' : '💀 Out of guesses', won ? 'good' : 'bad');
  document.getElementById('keyboard').style.opacity = '.4';
  document.getElementById('keyboard').style.pointerEvents = 'none';
  openModal();
}
function playBonus() { initRound(true, bonusRound + 1); }
function copyShare() {
  navigator.clipboard.writeText(document.getElementById('share-box').textContent)
    .then(() => setMessage('Result copied — paste it anywhere!', 'good'))
    .catch(() => prompt('Copy your result:', document.getElementById('share-box').textContent));
}

// ── Persistence ───────────────────────────────────────────────────────────
function saveState() {
  localStorage.setItem(SAVE_KEY, JSON.stringify({ guesses, currentRow, keyStates, gameOver }));
}
function loadState() {
  const raw = localStorage.getItem(SAVE_KEY);
  if (!raw) return;
  try {
    const s = JSON.parse(raw);
    guesses = s.guesses || [];
    currentRow = s.currentRow || 0;
    keyStates = s.keyStates || {};
    gameOver = s.gameOver || false;
  } catch {}
}

// ── Audio ─────────────────────────────────────────────────────────────────
let _audioCtx = null;
let _muted = localStorage.getItem('zw_mute') === '1';
(function(){
