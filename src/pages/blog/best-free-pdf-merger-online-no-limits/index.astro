    <AuthorBio author={author} />

    <div class="ad-slot" id="adSlot" style="margin-top:1.5rem;">
      <ins class="adsbygoogle"
           style="display:block"
           data-ad-client="ca-pub-6884221059402072"
           data-ad-slot="auto"
           data-ad-format="auto"
           data-full-width-responsive="true"></ins>
    </div>
    <script>
      (function(){
        var slot = document.getElementById('adSlot');
        var obs = new IntersectionObserver(function(entries){
          if(entries[0].isIntersecting){
            (adsbygoogle = window.adsbygoogle || []).push({});
            obs.disconnect();
          }
        }, { rootMargin: '200px' });
        obs.observe(slot);
      })();
    </script>
  </main>

  <Footer />

  <style>
    .article-body { display: flex; flex-direction: column; gap: 1.25rem; color: var(--muted); line-height: 1.8; font-size: .95rem; }
    .article-body h2 { font-size: 1.15rem; font-weight: 700; color: var(--text); margin-top: .5rem; }
    .article-body h3 { font-size: 1rem; font-weight: 700; color: var(--text); }
    .article-body p { margin: 0; }
    .article-body ul, .article-body ol { padding-left: 1.3rem; display: flex; flex-direction: column; gap: .5rem; }
    .step-box { background: var(--surface2); border-left: 3px solid var(--accent); border-radius: 0 var(--radius) var(--radius) 0; padding: 1rem 1.2rem; }
    .step-box strong { color: var(--text); }
    .cta-box { background: var(--surface2); border: 1px solid var(--accent); border-radius: var(--radius); padding: 1.2rem 1.4rem; }
    .cta-box p { color: var(--text) !important; font-weight: 500; }
    .cta-box a { color: var(--accent); font-weight: 700; }
    .article-meta { font-size: .8rem; color: var(--muted); margin-bottom: 1rem; }
    .winner-card { background: linear-gradient(135deg, rgba(56,189,248,.12), rgba(74,222,128,.12)); border: 1px solid var(--accent); border-radius: var(--radius); padding: 1.2rem 1.4rem; }
    .winner-card h3 { color: var(--accent); margin-top: 0; }
    .tool-card { background: var(--surface2); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.2rem 1.4rem; }
    .tool-card h3 { margin-top: 0; }
    .comparison-table { width: 100%; border-collapse: collapse; font-size: .88rem; }
    .comparison-table th, .comparison-table td { border: 1px solid var(--border); padding: .65rem .8rem; text-align: left; }
    .comparison-table th { background: var(--surface2); color: var(--text); font-weight: 600; }
    .check { color: var(--green); font-weight: 700; }
    .cross { color: var(--red); font-weight: 700; }
    .tool-launch-banner {
      display: flex; align-items: center; gap: .75rem;
      background: var(--accent); color: #fff;
      border-radius: var(--radius); padding: 1rem 1.2rem;
      text-decoration: none; font-weight: 700;
      transition: filter .2s;
    }
    .tool-launch-banner:hover { filter: brightness(1.1); }
    .tool-launch-icon { font-size: 1.2rem; }
    .tool-launch-text { flex: 1; }
  </style>
</Layout>
