            <td class="check">✓</td>
            <td class="check">✓</td>
            <td class="check">✓</td>
            <td class="cross">Desktop</td>
            <td class="check">✓</td>
            <td>Advanced PDF editing</td>
          </tr>
          <tr>
            <td><strong>iLovePDF</strong></td>
            <td class="cross">Cap</td>
            <td class="check">✓</td>
            <td class="check">✓</td>
            <td class="cross">Yes</td>
            <td class="cross">✗</td>
            <td>All-in-one online toolkit</td>
          </tr>
          <tr>
            <td><strong>Smallpdf</strong></td>
            <td class="cross">2/day</td>
