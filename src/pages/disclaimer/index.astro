---
import Layout from '@layouts/Layout.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';

const title = 'Disclaimer | ZippyWidgets';
const description = 'ZippyWidgets disclaimer. All calculations, metrics and outputs provided by ZippyWidgets tools are for informational purposes only. No guarantees of accuracy are made.';
const canonical = 'https://zippywidgets.online/disclaimer/';
---

<Layout title={title} description={description} canonical={canonical}>
  <Nav />

<main class="tool-page">
    <a class="back-btn" href="/">← Back to all tools</a>

    <div class="tool-header">
      <span class="icon">⚖️</span>
      <div>
        <h1>Disclaimer</h1>
        <p>Last updated: July 2026</p>
      </div>
    </div>

    <div class="card" style="display:flex;flex-direction:column;gap:1.4rem;">

      <section style="display:flex;flex-direction:column;gap:.75rem;">
        <h2 style="font-size:1.05rem;font-weight:700;color:var(--text);">Informational Purpose Only</h2>
        <p style="color:var(--muted);line-height:1.75;">All calculations, measurements, metrics, text transformations, and outputs provided by ZippyWidgets tools — including but not limited to the Age Calculator, Internet Speed Test, Word Counter, QR Code Generator, Random Picker Wheel, and Font Generator — are provided <strong>for informational and entertainment purposes only</strong>. ZippyWidgets makes no representations or warranties of any kind, express or implied, about the completeness, accuracy, reliability, suitability, or availability of any tool output.</p>
      </section>

      <section style="display:flex;flex-direction:column;gap:.75rem;">
        <h2 style="font-size:1.05rem;font-weight:700;color:var(--text);">No Professional Advice</h2>
        <p style="color:var(--muted);line-height:1.75;">Nothing on this website constitutes professional, legal, medical, financial, or technical advice. The outputs of these tools should not be relied upon as a substitute for qualified professional judgment. Specifically:</p>
        <ul style="color:var(--muted);line-height:1.9;padding-left:1.3rem;display:flex;flex-direction:column;gap:.35rem;">
          <li>The <strong>Age Calculator</strong> provides estimates based on the date entered. Results should not be used for legal age verification, official documentation, or any purpose requiring certified proof of age.</li>
          <li>The <strong>Internet Speed Test</strong> provides indicative measurements at the time of the test. Network performance varies by time of day, server load, and device conditions. Results should not be cited as official broadband performance data for contractual disputes with ISPs.</li>
          <li>The <strong>Word Counter</strong> counts text according to standard definitions. Platform character limits may differ from those shown due to encoding differences (e.g., emoji byte counts). Always verify limits in the target platform before publishing.</li>
          <li>The <strong>QR Code Generator</strong> produces codes intended for general use. We do not guarantee that all QR scanners will read every code, particularly at small sizes or low-contrast colour combinations.</li>
          <li>The <strong>Random Picker Wheel</strong> uses browser-based pseudo-random number generation. While statistically fair, it is not certified for legally binding lottery, raffle, or contest draws.</li>
          <li>The <strong>Font Generator</strong> converts text into Unicode character equivalents. Rendering may vary across platforms, operating systems, and device fonts. We do not guarantee identical visual output on all devices.</li>
        </ul>
      </section>

      <section style="display:flex;flex-direction:column;gap:.75rem;">
        <h2 style="font-size:1.05rem;font-weight:700;color:var(--text);">Limitation of Liability</h2>
        <p style="color:var(--muted);line-height:1.75;">To the fullest extent permitted by applicable law, ZippyWidgets and its operators shall not be liable for any direct, indirect, incidental, consequential, special, or punitive damages arising from your use of, or reliance on, any tool, output, or information provided on this website. All users assume full and sole responsibility for any action taken based on tool outputs. By using ZippyWidgets, you agree that you do so entirely at your own risk.</p>
      </section>

      <section style="display:flex;flex-direction:column;gap:.75rem;">
        <h2 style="font-size:1.05rem;font-weight:700;color:var(--text);">External Links</h2>
        <p style="color:var(--muted);line-height:1.75;">ZippyWidgets may contain links to external websites. These links are provided for convenience only. We have no control over the content of those sites and accept no responsibility for them or for any loss or damage that may arise from your use of them. The inclusion of any link does not imply endorsement by ZippyWidgets.</p>
      </section>

      <section style="display:flex;flex-direction:column;gap:.75rem;">
        <h2 style="font-size:1.05rem;font-weight:700;color:var(--text);">Accuracy of Tool Outputs</h2>
        <p style="color:var(--muted);line-height:1.75;">While we make every effort to keep tools accurate and up to date, ZippyWidgets cannot guarantee that tool outputs are free from error at all times. Platform character limits, speed test methodology, age calculation edge cases (such as leap year birthdays), and Unicode rendering all depend on external standards that may change. If you notice an inaccuracy, please <a href="/contact/" style="color:var(--accent);">contact us</a> and we will investigate promptly.</p>
      </section>

      <section style="display:flex;flex-direction:column;gap:.75rem;">
        <h2 style="font-size:1.05rem;font-weight:700;color:var(--text);">Changes to This Disclaimer</h2>
        <p style="color:var(--muted);line-height:1.75;">We reserve the right to update this disclaimer at any time. Changes will be reflected on this page with an updated date. Continued use of ZippyWidgets after any change constitutes your acceptance of the revised disclaimer. If you have questions about this disclaimer, please contact us at <a href="mailto:support@zippywidgets.online" style="color:var(--accent);">support@zippywidgets.online</a>.</p>
      </section>

    </div>
  </main>

  <Footer />
</Layout>
