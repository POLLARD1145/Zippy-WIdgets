---
import Layout from '@layouts/Layout.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';

const title = '404 — Page Not Found | ZippyWidgets';
const description = 'Sorry, the page you are looking for does not exist. Explore our free online tools, games and blog.';
---
<Layout title={title} description={description}>
  <Nav />

  <main class="tool-page max-w-4xl mx-auto w-full px-4 sm:px-6 lg:px-8" style="text-align:center;min-height:50vh;display:flex;flex-direction:column;align-items:center;justify-content:center;">
    <div class="card" style="max-width:520px;width:100%;">
      <div style="font-size:4rem;line-height:1;margin-bottom:1rem;">🚧</div>
      <h1 style="font-size:1.8rem;font-weight:800;margin-bottom:.5rem;">404 — Page Not Found</h1>
      <p style="color:var(--muted);margin-bottom:1.5rem;line-height:1.7;">We couldn't find the page you were looking for. It might have been moved, deleted, or the URL could be misspelled.</p>
      <div class="btn-group" style="justify-content:center;flex-wrap:wrap;">
        <a class="btn btn-primary" href="/">Back to homepage</a>
        <a class="btn btn-secondary" href="/tool/">Browse tools</a>
        <a class="btn btn-secondary" href="/game/">Play games</a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
