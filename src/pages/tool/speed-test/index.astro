                (adsbygoogle = window.adsbygoogle || []).push({});
                obs.disconnect();
              }
            }, { rootMargin: '200px' });
            obs.observe(slot);
          })();
  </script>

  <script is:inline>
    'use strict';
    
        const CF_DOWN = 'https://speed.cloudflare.com/__down?bytes=';
        const CF_UP   = 'https://speed.cloudflare.com/__up';
    
        let lastResult = null;
        let currentMode = 'standard';
    
        const MODES = {
          quick:    { ping: 5,  down: [5_000_000, 10_000_000],                   up: [1_000_000, 2_000_000]                   },
          standard: { ping: 10, down: [5_000_000, 10_000_000, 25_000_000],       up: [1_000_000, 2_000_000, 5_000_000]       },
          streamer: { ping: 15, down: [10_000_000, 25_000_000, 50_000_000, 100_000_000], up: [2_000_000, 5_000_000, 10_000_000] },
        };
    
        function setMode(mode) {
          currentMode = mode;
          ['quick','standard','streamer'].forEach(m => {
            document.getElementById('mode' + m.charAt(0).toUpperCase() + m.slice(1))
              .classList.toggle('selected', m === mode);
          });
        }
    
        async function startTest() {
          const btn = document.getElementById('startBtn');
          btn.disabled = true;
          btn.classList.add('running');
          document.getElementById('startLabel').textContent = 'Testing…';
    
          resetGauges();
          document.getElementById('qualityCard').style.display = 'none';
          document.getElementById('shareRow').style.display    = 'none';
    
          try {
            setStatus('Measuring ping & jitter…');
            const { ping, jitter } = await measurePing(MODES[currentMode].ping);
            showGauge('gaugePing', 'valPing', 'barPing', ping.toFixed(1), ping, 200);
            showGauge('gaugeJitter', 'valJitter', 'barJitter', jitter.toFixed(1), jitter, 50);
    
            setStatus('Testing download speed…');
            document.getElementById('gaugeDown').classList.add('active');
            const down = await measureDownload();
            showGauge('gaugeDown', 'valDown', 'barDown', down.toFixed(1), down, 1000);
    
            setStatus('Testing upload speed…');
            document.getElementById('gaugeUp').classList.add('active');
            const up = await measureUpload();
            showGauge('gaugeUp', 'valUp', 'barUp', up.toFixed(1), up, 1000);
    
            lastResult = { ping, jitter, down, up, ts: Date.now() };
    
            showQuality(down, up, ping, jitter);
            saveHistory(lastResult);
            renderHistory();
    
            document.getElementById('netInfoCard').style.display = 'block';
            document.getElementById('shareRow').style.display    = 'flex';
            setStatus('✅ Test complete');
    
            fetchNetInfo();
    
          } catch (e) {
            setStatus('⚠️ Test failed — check your connection and try again.');
          }
    
          btn.disabled = false;
          btn.classList.remove('running');
          document.getElementById('startLabel').textContent = 'Retest';
        }
    
        function resetGauges() {
          ['Ping','Jitter','Down','Up'].forEach(k => {
            const id = k === 'Down' ? 'gaugeDown' : k === 'Up' ? 'gaugeUp' : 'gauge' + k;
            document.getElementById(id).className = 'gauge';
            const valId = k === 'Down' ? 'valDown' : k === 'Up' ? 'valUp' : 'val' + k;
            const barId = k === 'Down' ? 'barDown' : k === 'Up' ? 'barUp' : 'bar' + k;
            document.getElementById(valId).textContent = '—';
            document.getElementById(barId).style.width = '0%';
          });
        }
    
        function showGauge(gaugeId, valId, barId, display, raw, max) {
          document.getElementById(gaugeId).classList.remove('active');
          document.getElementById(gaugeId).classList.add('done');
          document.getElementById(valId).textContent = display;
          const pct = Math.min(100, (raw / max) * 100);
          document.getElementById(barId).style.width = pct + '%';
        }
    
        function setStatus(msg) {
          document.getElementById('statusText').textContent = msg;
        }
    
        function animateValue(elId, barId, toVal, maxVal, duration) {
          const el  = document.getElementById(elId);
          const bar = document.getElementById(barId);
          const start = parseFloat(el.textContent) || 0;
          const startTime = performance.now();
          function step(now) {
            const p = Math.min(1, (now - startTime) / duration);
            const ease = 1 - Math.pow(1 - p, 3);
            const cur = start + (toVal - start) * ease;
            el.textContent = cur.toFixed(1);
            bar.style.width = Math.min(100, (cur / maxVal) * 100) + '%';
            if (p < 1) requestAnimationFrame(step);
          }
          requestAnimationFrame(step);
        }
    
        async function measurePing(samples) {
          const times = [];
          const url = 'https://speed.cloudflare.com/__down?bytes=1&t=' + Date.now();
          for (let i = 0; i < samples; i++) {
            const t0 = performance.now();
            await fetch(url + i, { cache: 'no-store' });
            times.push(performance.now() - t0);
          }
          const avg = times.reduce((a,b) => a+b, 0) / times.length;
          const jitter = times.reduce((sum, t) => sum + Math.abs(t - avg), 0) / times.length;
          return { ping: avg, jitter };
        }
    
        async function measureDownload() {
          const sizes = MODES[currentMode].down;
          let totalBits = 0, totalTime = 0;
          for (const bytes of sizes) {
            const t0 = performance.now();
            const res = await fetch(CF_DOWN + bytes + '&t=' + Date.now(), { cache: 'no-store' });
            await res.arrayBuffer();
            const elapsed = (performance.now() - t0) / 1000;
            totalBits += bytes * 8;
            totalTime += elapsed;
            const live = (totalBits / totalTime) / 1_000_000;
            animateValue('valDown', 'barDown', live, 1000, 400);
          }
          return (totalBits / totalTime) / 1_000_000;
        }
    
        async function measureUpload() {
          const sizes = MODES[currentMode].up;
          let totalBits = 0, totalTime = 0;
          for (const bytes of sizes) {
            const data = new Uint8Array(bytes);
            crypto.getRandomValues(data.subarray(0, Math.min(65536, bytes)));
            const t0 = performance.now();
            await fetch(CF_UP + '?t=' + Date.now(), {
              method: 'POST',
              body: data,
              cache: 'no-store'
            });
            const elapsed = (performance.now() - t0) / 1000;
            totalBits += bytes * 8;
            totalTime += elapsed;
            const live = (totalBits / totalTime) / 1_000_000;
            animateValue('valUp', 'barUp', live, 1000, 400);
          }
          return (totalBits / totalTime) / 1_000_000;
        }
    
        function showQuality(down, up, ping, jitter) {
          /* Each use-case returns 'good' | 'ok' | 'poor' plus a short descriptor */
          function rate(level) {
            const icons = { good: '✓', ok: '~', poor: '✗' };
            const labels = { good: 'Good', ok: 'OK', poor: 'Poor' };
            return { level, icon: icons[level], text: labels[level] };
          }
    
          const checks = [
            {
              name: '4K Streaming',
              badge: down >= 25 ? rate('good') : down >= 10 ? rate('ok') : rate('poor'),
              desc:  down >= 25 ? 'Ultra HD works smoothly' : down >= 10 ? 'May buffer on peak hours' : 'Stick to HD or lower',
            },
            {
              name: 'HD Streaming',
              badge: down >= 8 ? rate('good') : down >= 4 ? rate('ok') : rate('poor'),
              desc:  down >= 8 ? '1080p without interruptions' : down >= 4 ? '720p reliable, 1080p may dip' : 'Standard definition only',
            },
            {
              name: 'Video Calls',
              badge: (ping < 80 && jitter < 20 && up >= 2) ? rate('good')
                   : (ping < 150 && jitter < 40 && up >= 1) ? rate('ok')
                   : rate('poor'),
              desc:  (ping < 80 && jitter < 20 && up >= 2)  ? 'Crystal clear, no freezing'
                   : (ping < 150 && jitter < 40 && up >= 1) ? 'Usable but may stutter briefly'
                   : 'Likely choppy or frozen video',
            },
            {
              name: 'Online Gaming',
              badge: (ping < 40 && jitter < 10) ? rate('good')
                   : (ping < 100 && jitter < 30) ? rate('ok')
                   : rate('poor'),
              desc:  (ping < 40 && jitter < 10)  ? 'Competitive-ready, low lag'
                   : (ping < 100 && jitter < 30) ? 'Fine for casual & turn-based'
                   : 'Too laggy for fast-paced games',
            },
            {
              name: 'Remote Work / VPN',
              badge: (down >= 25 && up >= 10 && ping < 80)  ? rate('good')
                   : (down >= 10 && up >= 3  && ping < 150) ? rate('ok')
                   : rate('poor'),
              desc:  (down >= 25 && up >= 10 && ping < 80)  ? 'Fast file sync & calls'
                   : (down >= 10 && up >= 3  && ping < 150) ? 'Works for most tasks'
                   : 'VPN will feel slow or drop',
            },
            {
              name: 'Music Streaming',
              badge: down >= 1 ? rate('good') : down >= 0.5 ? rate('ok') : rate('poor'),
              desc:  down >= 1 ? 'Lossless & HD audio fine' : down >= 0.5 ? 'Standard quality only' : 'May buffer frequently',
            },
            {
              name: 'Fast Browsing',
              badge: (ping < 50 && down >= 10)  ? rate('good')
                   : (ping < 120 && down >= 3)  ? rate('ok')
                   : rate('poor'),
              desc:  (ping < 50 && down >= 10)  ? 'Pages load near-instantly'
                   : (ping < 120 && down >= 3)  ? 'Normal speed, slight delay'
                   : 'Noticeably slow page loads',
            },
            {
              name: 'Smart Home / IoT',
              badge: down >= 5 ? rate('good') : down >= 1 ? rate('ok') : rate('poor'),
              desc:  down >= 5 ? 'Handles many devices at once' : down >= 1 ? 'Basic devices work fine' : 'May disconnect under load',
            },
          ];
    
          const grid = document.getElementById('qualityGrid');
          grid.innerHTML = checks.map(c => `
            <div class="quality-item">
              <span class="q-badge ${c.badge.level}">${c.badge.icon} ${c.badge.text}</span>
              <div class="q-label">
                <span class="q-name">${c.name}</span>
                <span class="q-desc">${c.desc}</span>
              </div>
            </div>`).join('');
          document.getElementById('qualityCard').style.display = 'block';
        }
    
        function truncateIp(ip) {
          if (!ip) return '—';
          if (ip.length <= 20) return ip;
          return ip.substring(0, 18) + '…';
        }
    
        async function fetchNetInfo() {
          const ipEl  = document.getElementById('niIp');
          const ispEl = document.getElementById('niIsp');
          const locEl = document.getElementById('niLoc');
          let data = null;
    
          const apis = [
            async () => { const r = await fetch('https://ipwho.is/'); const d = await r.json(); return { ip: d.ip, org: d.connection?.isp || d.org, city: d.city, country: d.country }; },
            async () => { const r = await fetch('https://ip-api.com/json/?fields=query,isp,city,country'); const d = await r.json(); return { ip: d.query, org: d.isp, city: d.city, country: d.country }; },
            async () => { const r = await fetch('https://ipapi.co/json/'); const d = await r.json(); return { ip: d.ip, org: d.org, city: d.city, country: d.country_name }; },
          ];
    
          for (const api of apis) {
            try { data = await api(); if (data && data.ip) break; } catch (_) {}
          }
    
          if (data && data.ip) {
            ipEl.textContent  = truncateIp(data.ip);
            ipEl.title        = data.ip;
            ispEl.textContent = data.org ? '· ' + data.org : '';
            locEl.textContent = [data.city, data.country].filter(Boolean).join(', ') || '—';
          } else {
            ipEl.textContent  = 'Unavailable';
            ispEl.textContent = '';
            locEl.textContent = 'Unavailable';
          }
          const conn = navigator.connection;
          document.getElementById('niConn').textContent =
            conn ? (conn.effectiveType || conn.type || '—').toUpperCase() : '—';
        }
    
        function saveHistory(r) {
          let hist = JSON.parse(localStorage.getItem('zw_speed_hist') || '[]');
          hist.unshift(r);
          if (hist.length > 10) hist = hist.slice(0, 10);
          localStorage.setItem('zw_speed_hist', JSON.stringify(hist));
        }
    
        function renderHistory() {
          const hist = JSON.parse(localStorage.getItem('zw_speed_hist') || '[]');
          if (!hist.length) return;
          const body = document.getElementById('historyBody');
          body.innerHTML = hist.map(r => {
            const d = new Date(r.ts);
            const t = d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            return `<tr>
              <td>${t}</td>
              <td>${r.down.toFixed(1)} Mbps</td>
              <td>${r.up.toFixed(1)} Mbps</td>
              <td>${r.ping.toFixed(0)} ms</td>
              <td>${r.jitter.toFixed(0)} ms</td>
            </tr>`;
          }).join('');
          document.getElementById('historyCard').style.display = 'block';
        }
    
        function clearHistory() {
          localStorage.removeItem('zw_speed_hist');
          document.getElementById('historyBody').innerHTML = '';
          document.getElementById('historyCard').style.display = 'none';
        }
    
        const SITE_URL = 'https://zippywidgets.online/tool/speed-test/';
    
        function shareResult() {
          if (!lastResult) return;
          const text = `My internet speed: ↓ ${lastResult.down.toFixed(1)} Mbps | ↑ ${lastResult.up.toFixed(1)} Mbps | Ping ${lastResult.ping.toFixed(0)} ms — tested at ${SITE_URL}`;
          if (navigator.share) {
            navigator.share({ title: 'My Speed Test Result', text, url: SITE_URL });
          } else {
            copyResult();
          }
        }
    
        function copyResult() {
          if (!lastResult) return;
          const text = `My internet speed: ↓ ${lastResult.down.toFixed(1)} Mbps | ↑ ${lastResult.up.toFixed(1)} Mbps | Ping ${lastResult.ping.toFixed(0)} ms | Jitter ${lastResult.jitter.toFixed(0)} ms — ${SITE_URL}`;
          navigator.clipboard.writeText(text).then(() => {
            const btn = document.querySelector('[onclick="copyResult()"]');
            if (btn) { btn.textContent = '✅ Copied!'; setTimeout(() => btn.textContent = '📋 Copy Result', 2000); }
          });
        }
    
        // Load history on page load
        renderHistory();
        fetchNetInfo();
  </script>
</Layout>
