    /* Stats strip */
    .wx-stats-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: .75rem;
    }
    @media (min-width: 500px) { .wx-stats-grid { grid-template-columns: repeat(6, 1fr); } }
    .wx-stat {
      background: var(--surface2); border: 1px solid var(--border);
      border-radius: 10px; padding: .75rem .5rem; text-align: center;
    }
    .wx-stat-val { font-size: 1.05rem; font-weight: 800; color: var(--accent); }
    .wx-stat-lbl { font-size: .68rem; color: var(--muted); margin-top: .2rem; text-transform: uppercase; letter-spacing: .05em; }

    /* ── Section title ── */
    .wx-section-title {
      font-size: .8rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: .07em; color: var(--muted); margin-bottom: .85rem;
    }

    /* ── Hourly strip ── */
    .wx-hourly-strip {
      display: flex; gap: .5rem; overflow-x: auto;
