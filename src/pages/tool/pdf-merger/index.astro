---
import Layout from '@layouts/Layout.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import BreadcrumbSchema from '@components/BreadcrumbSchema.astro';
import AiAnswer from '@components/AiAnswer.astro';
import LastUpdated from '@components/LastUpdated.astro';
import { FEATURES } from '@data/config.ts';

const title = 'Free PDF Merger — Combine PDF Files Online, No Limits, No Sign-up';
const description = 'Merge multiple PDF files into one for free. No file size limits, no watermarks, no sign-up. Reorder pages and download your combined PDF instantly in your browser.';
const canonical = 'https://zippywidgets.online/tool/pdf-merger/';
const updated = '2026-07-17';
---

<Layout title={title} description={description} canonical={canonical}>
  <Fragment slot="head">
    <BreadcrumbSchema items={[
      { name: 'Home', item: 'https://zippywidgets.online/' },
      { name: 'Tools', item: 'https://zippywidgets.online/tool/' },
      { name: 'PDF Merger', item: 'https://zippywidgets.online/tool/pdf-merger/' },
    ]} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "HowTo",
      "name": "How to merge PDF files online",
      "description": "Combine multiple PDF files into a single document in your browser, with no sign-up and no upload.",
      "step": [
        { "@type": "HowToStep", "name": "Upload your PDFs", "text": "Click the upload box or drag and drop your PDF files. You can add as many as you need." },
        { "@type": "HowToStep", "name": "Reorder if needed", "text": "Use the up and down arrows next to each file to set the order of the merged PDF." },
        { "@type": "HowToStep", "name": "Click Merge PDFs", "text": "The tool combines every page from every file into a single document." },
        { "@type": "HowToStep", "name": "Download", "text": "Save the merged PDF to your device when the download button appears." }
      ]
    })} />
  </Fragment>
  <Nav />

  <script type="application/ld+json">
    {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Free PDF Merger",
    "url": "https://zippywidgets.online/tool/pdf-merger/",
    "description": "Merge multiple PDF files into one PDF online for free. No file size limits, no watermarks, no sign-up required. Works entirely in your browser.",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Any",
    "browserRequirements": "Requires HTML5, JavaScript, and pdf-lib",
    "featureList": "Merge multiple PDFs, drag-and-drop reorder, no file size limit, no watermark, instant download",
    "dateModified": "2026-07-17",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
  </script>
  <script type="application/ld+json">
    {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Is this PDF merger really free?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. The ZippyWidgets PDF Merger is completely free. There are no file size limits, no page limits, no watermarks, and no sign-up required." }
      },
      {
        "@type": "Question",
        "name": "Do my PDF files get uploaded to a server?",
        "acceptedAnswer": { "@type": "Answer", "text": "No. The entire merge process happens in your browser using JavaScript. Your PDFs are never uploaded to any server, so your documents stay private and secure." }
      },
      {
        "@type": "Question",
        "name": "Can I reorder PDF pages before merging?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes. After uploading your PDFs, drag and drop them into the desired order, or use the up/down arrows next to each file. The merged PDF will follow the order shown in the list." }
      },
      {
        "@type": "Question",
        "name": "What is the maximum file size?",
        "acceptedAnswer": { "@type": "Answer", "text": "There is no artificial file size limit. The only limits are your device's memory and browser capabilities. Most users can merge files totaling several hundred megabytes." }
      }
    ]
  }
  </script>
<main class="tool-page max-w-4xl mx-auto w-full px-4 sm:px-6 lg:px-8">
    <a class="back-btn" href="/">← Back to all tools</a>

    <div class="tool-header">
      <span class="icon">📑</span>
      <div>
        <h1>Free PDF Merger — Combine PDF Files Online</h1>
        <p>Merge multiple PDFs into one file instantly. No limits, no watermarks, no sign-up. Reorder pages and download your combined PDF in seconds.</p>
      </div>
    </div>

    <AiAnswer
      tool="PDF Merger"
      what="A free online tool that combines multiple PDF files into a single document. Reorder pages, merge unlimited files, and download the result — all in your browser with no sign-up, no watermark, and no file size limits."
      privacy="Yes. PDFs are processed locally with pdf-lib and never uploaded to any server."
    />

    <div class="card">
      <div class="drop-zone" id="dropZone">
        <div class="icon">📁</div>
        <p><strong>Click to upload PDFs</strong> or drag and drop them here</p>
        <p style="font-size:.8rem;margin-top:.4rem;">You can select multiple PDF files at once</p>
        <input type="file" id="fileInput" accept=".pdf,application/pdf" multiple />
      </div>

      <div class="file-list" id="fileList"></div>

      <div class="progress-bar" id="progressBar"><div class="fill" id="progressFill"></div></div>
      <div class="status-msg" id="statusMsg"></div>

      <div class="btn-group merge-btn" id="actionButtons" style="display:none;">
        <button class="btn btn-primary" id="mergeBtn" onclick="mergePdfs()">Merge PDFs</button>
        <button class="btn btn-secondary" onclick="clearFiles()">Clear All</button>
      </div>
    </div>

    {FEATURES.adsEnabled && (
      <>
        <div class="ad-slot" id="adSlot">
          <ins class="adsbygoogle"
               style="display:block"
               data-ad-client="ca-pub-6884221059402072"
               data-ad-slot="auto"
               data-ad-format="auto"
               data-full-width-responsive="true"></ins>
        </div>
        <script is:inline>
          (function(){
            var slot = document.getElementById('adSlot');
            if (!slot) return;
            var obs = new IntersectionObserver(function(entries){
              if(entries[0].isIntersecting){
                (adsbygoogle = window.adsbygoogle || []).push({});
                obs.disconnect();
              }
            }, { rootMargin: '200px' });
            obs.observe(slot);
          })();
        </script>
      </>
    )}

    <section class="card" style="margin-top:1rem;">
      <h2 style="font-size:1.1rem;font-weight:700;margin-bottom:1rem;">How to Merge PDF Files Online</h2>
      <div style="display:flex;flex-direction:column;gap:1rem;color:var(--muted);line-height:1.75;font-size:.92rem;">
        <p>Combining PDFs should be simple. With the ZippyWidgets PDF Merger, you don't need to install software, create an account, or worry about file size limits. Everything happens locally in your browser.</p>
        <ol style="padding-left:1.2rem;display:flex;flex-direction:column;gap:.4rem;">
          <li><strong>Upload your PDFs:</strong> Click the box above or drag and drop your files into it. You can add as many PDFs as you need.</li>
          <li><strong>Reorder if needed:</strong> Use the arrows next to each file to move it up or down. The final PDF will follow the order shown.</li>
          <li><strong>Click Merge PDFs:</strong> The tool combines every page from every file into a single document.</li>
          <li><strong>Download:</strong> Save the merged PDF to your device when the button appears.</li>
        </ol>

        <h3 style="font-size:.95rem;font-weight:700;color:var(--text);margin-top:.25rem;">Why Use an Online PDF Merger?</h3>
        <p>Merging PDFs is one of the most common PDF tasks, but desktop software like Adobe Acrobat is expensive and many online tools add watermarks, compress your pages, or limit you to a small number of files. This tool is different: it is completely free, has no artificial limits, and keeps your documents private by processing them locally on your device.</p>

        <h3 style="font-size:.95rem;font-weight:700;color:var(--text);margin-top:.25rem;">Is My Data Private?</h3>
        <p>Yes. The PDF merger uses the <a href="https://pdf-lib.js.org/" target="_blank" rel="noopener" style="color:var(--accent);">pdf-lib</a> library to read and combine your PDFs directly in your browser. Your files are never uploaded to a server, cloud storage, or third-party API. Once you close the tab, nothing is retained.</p>

        <h3 style="font-size:.95rem;font-weight:700;color:var(--text);margin-top:.25rem;">Tips for Best Results</h3>
        <ul style="padding-left:1.2rem;display:flex;flex-direction:column;gap:.4rem;">
          <li>Make sure each file is a valid PDF before uploading. Corrupted or encrypted PDFs may fail to merge.</li>
          <li>If a PDF is password-protected, remove the password first using your PDF reader before merging.</li>
          <li>For very large files (hundreds of MB), be patient — the merge speed depends on your device's memory and processor.</li>
          <li>Use the same page orientation (portrait/landscape) throughout if you want a consistent final document.</li>
        </ul>

        <h3 style="font-size:.95rem;font-weight:700;color:var(--text);margin-top:.25rem;">Learn More</h3>
        <p>For detailed instructions on processing large document batches without losing quality, read our full <a href="/blog/best-free-pdf-merger-online-no-limits/" style="color:var(--accent);">PDF Merger Optimization Guide</a>. You may also be interested in our <a href="/blog/complete-guide-to-online-pdf-management/" style="color:var(--accent);">Complete Guide to Online PDF Management</a>, <a href="/tool/pdf-page-editor/" style="color:var(--accent);">PDF Page Editor</a>, and <a href="/tool/jpg-to-pdf/" style="color:var(--accent);">JPG to PDF converter</a>.</p>
      </div>
    </section>

    <LastUpdated date={updated} />
  </main>

  <Footer />

  <style>
    .drop-zone {
          border: 2px dashed var(--border);
          border-radius: var(--radius);
          padding: 2.5rem 1.5rem;
          text-align: center;
          color: var(--muted);
          background: var(--surface2);
          transition: border-color .2s, background .2s;
          cursor: pointer;
        }
        .drop-zone:hover, .drop-zone.drag-over {
          border-color: var(--accent);
          background: rgba(56,189,248,.08);
        }
        .drop-zone .icon { font-size: 2.5rem; margin-bottom: .75rem; }
        .drop-zone input { display: none; }
        .file-list { display: flex; flex-direction: column; gap: .6rem; margin-top: 1rem; }
        .file-item {
          display: flex; align-items: center; gap: .75rem;
          background: var(--surface2); border: 1px solid var(--border);
          border-radius: var(--radius); padding: .75rem 1rem;
        }
        .file-item .name { flex: 1; font-size: .9rem; color: var(--text); word-break: break-all; }
        .file-item .size { font-size: .78rem; color: var(--muted); white-space: nowrap; }
        .file-item .actions { display: flex; gap: .35rem; }
        .file-item button {
          background: transparent; border: 1px solid var(--border); color: var(--muted);
          border-radius: 6px; padding: .35rem .55rem; cursor: pointer; font-size: .8rem;
          transition: all .2s;
        }
        .file-item button:hover { border-color: var(--accent); color: var(--accent); }
        .file-item button.remove:hover { border-color: var(--red); color: var(--red); }
        .merge-btn { margin-top: 1.25rem; }
        .progress-bar {
          width: 100%; height: 6px; background: var(--surface2); border-radius: 99px;
          overflow: hidden; margin-top: 1rem; display: none;
        }
        .progress-bar .fill {
          height: 100%; width: 0%; background: var(--accent); border-radius: 99px;
          transition: width .3s;
        }
        .status-msg { margin-top: .75rem; font-size: .85rem; color: var(--muted); min-height: 1.25rem; }
        .status-msg.error { color: var(--red); }
        .status-msg.success { color: var(--green); }
  </style>

  <script is:inline src="https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js"></script>

  <script is:inline>
    'use strict';
    
        const dropZone = document.getElementById('dropZone');
        const fileInput = document.getElementById('fileInput');
        const fileList = document.getElementById('fileList');
        const actionButtons = document.getElementById('actionButtons');
        const statusMsg = document.getElementById('statusMsg');
        const progressBar = document.getElementById('progressBar');
        const progressFill = document.getElementById('progressFill');
    
        let files = [];
    
        dropZone.addEventListener('click', () => fileInput.click());
    
        dropZone.addEventListener('dragover', (e) => {
          e.preventDefault();
          dropZone.classList.add('drag-over');
        });
    
        dropZone.addEventListener('dragleave', () => {
          dropZone.classList.remove('drag-over');
        });
    
        dropZone.addEventListener('drop', (e) => {
          e.preventDefault();
          dropZone.classList.remove('drag-over');
          handleFiles(e.dataTransfer.files);
        });
    
        fileInput.addEventListener('change', () => {
          handleFiles(fileInput.files);
          fileInput.value = '';
        });
    
        function handleFiles(fileListObj) {
          const newFiles = Array.from(fileListObj).filter(f => f.type === 'application/pdf' || f.name.toLowerCase().endsWith('.pdf'));
          if (newFiles.length === 0 && fileListObj.length > 0) {
            showStatus('Please upload PDF files only.', 'error');
            return;
          }
          files = files.concat(newFiles);
          renderFiles();
        }
    
        function formatSize(bytes) {
          if (bytes === 0) return '0 B';
          const units = ['B', 'KB', 'MB', 'GB'];
          const i = Math.floor(Math.log(bytes) / Math.log(1024));
          return (bytes / Math.pow(1024, i)).toFixed(i > 0 ? 1 : 0) + ' ' + units[i];
        }
    
        function renderFiles() {
          fileList.innerHTML = '';
          if (files.length === 0) {
            actionButtons.style.display = 'none';
            showStatus('', '');
            return;
          }
    
          files.forEach((file, index) => {
            const item = document.createElement('div');
            item.className = 'file-item';
            item.innerHTML = `
              <span class="name">${escapeHtml(file.name)}</span>
              <span class="size">${formatSize(file.size)}</span>
              <div class="actions">
                <button onclick="moveFile(${index}, -1)" ${index === 0 ? 'disabled' : ''} title="Move up">↑</button>
                <button onclick="moveFile(${index}, 1)" ${index === files.length - 1 ? 'disabled' : ''} title="Move down">↓</button>
                <button class="remove" onclick="removeFile(${index})" title="Remove">×</button>
              </div>
            `;
            fileList.appendChild(item);
          });
    
          actionButtons.style.display = 'flex';
          showStatus(`${files.length} PDF${files.length === 1 ? '' : 's'} ready to merge.`, '');
        }
    
        function moveFile(index, direction) {
          const newIndex = index + direction;
          if (newIndex < 0 || newIndex >= files.length) return;
          const temp = files[index];
          files[index] = files[newIndex];
          files[newIndex] = temp;
          renderFiles();
        }
    
        function removeFile(index) {
          files.splice(index, 1);
          renderFiles();
        }
    
        function clearFiles() {
          files = [];
          renderFiles();
          progressBar.style.display = 'none';
          progressFill.style.width = '0%';
        }
    
        function showStatus(msg, type) {
          statusMsg.textContent = msg;
          statusMsg.className = 'status-msg' + (type ? ' ' + type : '');
        }
    
        function escapeHtml(text) {
          const div = document.createElement('div');
          div.textContent = text;
          return div.innerHTML;
        }
    
        async function mergePdfs() {
          if (files.length === 0) return;
          if (files.length === 1) {
            showStatus('Add at least 2 PDFs to merge, or download the single file as-is.', 'error');
            return;
          }
    
          const mergeBtn = document.getElementById('mergeBtn');
          mergeBtn.disabled = true;
          mergeBtn.textContent = 'Merging...';
          showStatus('Loading PDFs...', '');
          progressBar.style.display = 'block';
          progressFill.style.width = '5%';
    
          try {
            const { PDFDocument } = PDFLib;
            const mergedPdf = await PDFDocument.create();
    
            for (let i = 0; i < files.length; i++) {
              const arrayBuffer = await files[i].arrayBuffer();
              const pdf = await PDFDocument.load(arrayBuffer, { ignoreEncryption: false });
              const copiedPages = await mergedPdf.copyPages(pdf, pdf.getPageIndices());
              copiedPages.forEach(page => mergedPdf.addPage(page));
    
              const pct = Math.round(((i + 1) / files.length) * 90) + 5;
              progressFill.style.width = pct + '%';
              showStatus(`Merging ${files[i].name}...`, '');
            }
    
            progressFill.style.width = '95%';
            showStatus('Saving combined PDF...', '');
            const mergedBytes = await mergedPdf.save();
            const blob = new Blob([mergedBytes], { type: 'application/pdf' });
            const url = URL.createObjectURL(blob);
    
            const a = document.createElement('a');
            a.href = url;
            a.download = 'merged-document.pdf';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
    
            progressFill.style.width = '100%';
            showStatus('✅ Merged PDF downloaded successfully!', 'success');
          } catch (err) {
            console.error(err);
            showStatus('Error: ' + (err.message || 'Could not merge PDFs. Make sure files are valid and not password-protected.'), 'error');
          } finally {
            mergeBtn.disabled = false;
            mergeBtn.textContent = 'Merge PDFs';
            setTimeout(() => { progressBar.style.display = 'none'; progressFill.style.width = '0%'; }, 2000);
          }
        }
  </script>
</Layout>
