---
import Layout from '@layouts/Layout.astro';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';

const title = 'File Beam — Send Files Between Devices on Same Wi-Fi, No Cloud | ZippyWidgets';
const description = 'Transfer files directly between phones, tablets and computers on the same Wi-Fi network. No cloud, no upload, no sign-up. Browser-to-browser WebRTC connection keeps your files private.';
const canonical = 'https://zippywidgets.online/tool/file-beam/';
---

<Layout title={title} description={description} canonical={canonical}>
  <Nav />

  <script type="application/ld+json">
    {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "File Beam",
    "url": "https://zippywidgets.online/tool/file-beam/",
    "description": "Transfer files directly between devices on the same Wi-Fi network using browser-to-browser WebRTC. No cloud storage, no upload, no sign-up.",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Any",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }
  </script>
  <script type="application/ld+json">
    {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How does File Beam transfer files without a server?",
        "acceptedAnswer": { "@type": "Answer", "text": "File Beam uses WebRTC, a browser technology that creates a direct peer-to-peer connection between two devices. A short connection code is exchanged manually (copy and paste) to establish the link. Once connected, files flow directly from one device to the other — no cloud, no upload, no intermediary server." }
      },
      {
        "@type": "Question",
        "name": "Do both devices need to be on the same Wi-Fi network?",
        "acceptedAnswer": { "@type": "Answer", "text": "For best results, yes. WebRTC can work across networks using STUN servers, but transfer speeds are fastest and most reliable when both devices are on the same local network. The tool uses Google's public STUN servers to help establish the connection." }
      },
      {
        "@type": "Question",
        "name": "Is there a file size limit?",
        "acceptedAnswer": { "@type": "Answer", "text": "The practical limit is about 500 MB per file, determined by your device's available memory. Files are sent in chunks over the WebRTC data channel, so large files work but may take time depending on your network speed." }
      },
      {
        "@type": "Question",
        "name": "Are my files uploaded to any server?",
        "acceptedAnswer": { "@type": "Answer", "text": "No. Files are transferred directly between the two devices using a WebRTC data channel. The only external request is to Google's STUN servers, which help the devices find each other on the network — no file data ever touches a server." }
      }
    ]
  }
  </script>

<main class="tool-page max-w-4xl mx-auto w-full px-4 sm:px-6 lg:px-8">
    <a class="back-btn" href="/">← Back to all tools</a>

    <div class="tool-header">
      <span class="icon">📡</span>
      <div>
        <h1>File Beam — Send Files Between Devices on Same Wi-Fi</h1>
        <p>Transfer files directly between your phone, tablet, and computer. No cloud, no upload, no sign-up — just a direct browser-to-browser connection over your local network.</p>
      </div>
    </div>

    <div class="card">
      <div class="role-selector" id="roleSelector">
        <button class="role-btn active" id="sendBtn" onclick="selectRole('send')">📤 Send files</button>
        <button class="role-btn" id="recvBtn" onclick="selectRole('recv')">📥 Receive files</button>
      </div>

      <!-- SEND PANEL -->
      <div id="sendPanel" class="role-panel">
        <div class="drop-zone" id="sendDropZone">
          <div class="icon">📁</div>
          <p><strong>Click to select files</strong> or drag and drop them here</p>
          <p style="font-size:.8rem;margin-top:.4rem;">Any file type, up to 500&nbsp;MB per file</p>
          <input type="file" id="sendFileInput" multiple />
        </div>

        <div class="file-list" id="sendFileList"></div>

        <div class="step-section" id="sendStep1" style="display:none;">
          <h3>Step 1 — Create connection code</h3>
          <p>Click the button below to generate a connection code. You'll share this with the receiving device.</p>
          <button class="btn btn-primary" id="createOfferBtn" onclick="createOffer()">Create connection code</button>
        </div>

        <div class="step-section" id="sendStep2" style="display:none;">
          <h3>Step 2 — Share this code</h3>
          <p>Copy this code and send it to the receiving device (via messaging app, email, or just read it aloud).</p>
          <div class="code-box" id="offerCodeBox"></div>
          <button class="btn btn-secondary" onclick="copyCode('offerCodeBox')">Copy code</button>
        </div>

        <div class="step-section" id="sendStep3" style="display:none;">
          <h3>Step 3 — Paste the answer code</h3>
          <p>The receiving device will give you an answer code. Paste it below to complete the connection.</p>
          <textarea id="answerInput" placeholder="Paste the answer code here…" rows="4"></textarea>
          <button class="btn btn-primary" id="acceptAnswerBtn" onclick="acceptAnswer()">Connect</button>
        </div>

        <div class="connection-status" id="sendStatus"></div>
      </div>

      <!-- RECEIVE PANEL -->
      <div id="recvPanel" class="role-panel" style="display:none;">
        <div class="step-section">
          <h3>Step 1 — Paste the connection code</h3>
          <p>Get the connection code from the sending device and paste it below.</p>
          <textarea id="offerInput" placeholder="Paste the connection code here…" rows="4"></textarea>
          <button class="btn btn-primary" id="acceptOfferBtn" onclick="acceptOffer()">Accept connection</button>
        </div>

        <div class="step-section" id="recvStep2" style="display:none;">
          <h3>Step 2 — Share this answer code</h3>
          <p>Copy this answer code and send it back to the sending device to complete the connection.</p>
          <div class="code-box" id="answerCodeBox"></div>
          <button class="btn btn-secondary" onclick="copyCode('answerCodeBox')">Copy code</button>
        </div>

        <div class="connection-status" id="recvStatus"></div>
        <div class="file-list" id="recvFileList"></div>
      </div>

      <div class="transfer-area" id="transferArea" style="display:none;">
        <div class="transfer-header">
          <span id="transferTitle">Connected — transferring files</span>
          <button class="btn btn-secondary" onclick="disconnect()">Disconnect</button>
        </div>
        <div class="progress-bar" id="transferProgress"><div class="fill" id="transferFill"></div></div>
        <div class="transfer-info" id="transferInfo"></div>
      </div>
    </div>

    <div class="ad-slot" id="adSlot">
      <ins class="adsbygoogle"
           style="display:block"
           data-ad-client="ca-pub-6884221059402072"
           data-ad-slot="auto"
           data-ad-format="auto"
           data-full-width-responsive="true"></ins>
    </div>
    <script is:inline>
      (function(){
        var slot = document.getElementById('adSlot');
        var obs = new IntersectionObserver(function(entries){
          if(entries[0].isIntersecting){
            (adsbygoogle = window.adsbygoogle || []).push({});
            obs.disconnect();
          }
        }, { rootMargin: '200px' });
        obs.observe(slot);
      })();
    </script>

    <section class="card" style="margin-top:1rem;">
      <h2 style="font-size:1.1rem;font-weight:700;margin-bottom:1rem;">How File Beam Works</h2>
      <div style="display:flex;flex-direction:column;gap:1rem;color:var(--muted);line-height:1.75;font-size:.92rem;">
        <p>File Beam creates a <strong>direct peer-to-peer connection</strong> between two devices using WebRTC — the same technology that powers video calls in browsers. No cloud storage, no upload servers, and no account are needed. Files travel straight from one device to the other.</p>

        <h3 style="font-size:.95rem;font-weight:700;color:var(--text);margin-top:.25rem;">Step-by-Step Guide</h3>
        <ol style="padding-left:1.2rem;display:flex;flex-direction:column;gap:.4rem;">
          <li><strong>On the sending device:</strong> Select the files you want to send, then click "Create connection code". A short code will appear.</li>
          <li><strong>Share the code:</strong> Send the connection code to the receiving device via any messaging app, email, or by typing it manually.</li>
          <li><strong>On the receiving device:</strong> Choose "Receive files", paste the connection code, and click "Accept connection". An answer code will appear.</li>
          <li><strong>Share the answer code:</strong> Send the answer code back to the sending device.</li>
          <li><strong>On the sending device:</strong> Paste the answer code and click "Connect". The connection is now established.</li>
          <li><strong>Transfer begins:</strong> Files flow directly between the two devices. A progress bar shows the transfer status.</li>
        </ol>

        <h3 style="font-size:.95rem;font-weight:700;color:var(--text);margin-top:.25rem;">Why Use File Beam Instead of Cloud Storage?</h3>
        <p>Cloud services like Google Drive, Dropbox, or WeTransfer require you to upload files to a server, then download them on the other device. This is slow for large files on slow connections, and it means your files sit on someone else's server. File Beam skips the middleman entirely — files go directly from sender to receiver over your local Wi-Fi, which is faster, more private, and works without an internet connection (as long as both devices are on the same network).</p>

        <h3 style="font-size:.95rem;font-weight:700;color:var(--text);margin-top:.25rem;">Privacy</h3>
        <p>Files are transferred directly between the two devices using an encrypted WebRTC data channel. No file data is ever sent to any server. The only external request is to Google's public STUN servers, which help the devices discover each other's network addresses — this is standard WebRTC infrastructure and no file content passes through it. Once the transfer is complete and you disconnect, all data is cleared from memory.</p>

        <h3 style="font-size:.95rem;font-weight:700;color:var(--text);margin-top:.25rem;">Tips for Best Results</h3>
        <ul style="padding-left:1.2rem;display:flex;flex-direction:column;gap:.4rem;">
          <li>Keep both devices on the same Wi-Fi network for the fastest and most reliable transfer.</li>
          <li>Keep both browser tabs open and in the foreground during transfer — background tabs may be throttled by the browser.</li>
          <li>The connection codes are long — use copy and paste rather than typing them manually.</li>
          <li>If the connection fails, try creating a new connection code and starting again.</li>
          <li>Very large files (hundreds of MB) may take time — the transfer speed depends on your Wi-Fi bandwidth.</li>
        </ul>
      </div>
    </section>

    <section class="faq-section card" style="margin-top:1rem;">
      <h2 style="font-size:1.1rem;font-weight:700;margin-bottom:1rem;">Frequently Asked Questions</h2>
      <div class="faq-item">
        <h3>How does File Beam transfer files without a server?</h3>
        <p>File Beam uses WebRTC, a browser technology that creates a direct peer-to-peer connection between two devices. A short connection code is exchanged manually (copy and paste) to establish the link. Once connected, files flow directly from one device to the other — no cloud, no upload, no intermediary server.</p>
      </div>
      <div class="faq-item">
        <h3>Do both devices need to be on the same Wi-Fi network?</h3>
        <p>For best results, yes. WebRTC can work across networks using STUN servers, but transfer speeds are fastest and most reliable when both devices are on the same local network. The tool uses Google's public STUN servers to help establish the connection.</p>
      </div>
      <div class="faq-item">
        <h3>Is there a file size limit?</h3>
        <p>The practical limit is about 500 MB per file, determined by your device's available memory. Files are sent in chunks over the WebRTC data channel, so large files work but may take time depending on your network speed.</p>
      </div>
      <div class="faq-item">
        <h3>Are my files uploaded to any server?</h3>
        <p>No. Files are transferred directly between the two devices using a WebRTC data channel. The only external request is to Google's STUN servers, which help the devices find each other on the network — no file data ever touches a server.</p>
      </div>
    </section>
  </main>

  <Footer />

  <style>
    .role-selector {
          display: flex; gap: .5rem; margin-bottom: 1.25rem;
        }
        .role-btn {
          flex: 1; padding: .75rem 1rem; border: 2px solid var(--border);
          border-radius: var(--radius); background: var(--surface2); color: var(--muted);
          font-size: .9rem; font-weight: 600; cursor: pointer; transition: all .2s;
        }
        .role-btn.active { border-color: var(--accent); color: var(--accent); background: rgba(56,189,248,.08); }
        .role-btn:hover:not(.active) { border-color: var(--accent); }

        .role-panel { display: flex; flex-direction: column; gap: 1rem; }

        .drop-zone {
          border: 2px dashed var(--border); border-radius: var(--radius);
          padding: 2rem 1.5rem; text-align: center; color: var(--muted);
          background: var(--surface2); transition: border-color .2s, background .2s; cursor: pointer;
        }
        .drop-zone:hover, .drop-zone.drag-over { border-color: var(--accent); background: rgba(56,189,248,.08); }
        .drop-zone .icon { font-size: 2.5rem; margin-bottom: .75rem; }
        .drop-zone input { display: none; }

        .file-list { display: flex; flex-direction: column; gap: .5rem; }
        .file-item {
          display: flex; align-items: center; gap: .75rem;
          background: var(--surface2); border: 1px solid var(--border);
          border-radius: var(--radius); padding: .65rem 1rem;
        }
        .file-item .name { flex: 1; font-size: .88rem; color: var(--text); word-break: break-all; }
        .file-item .size { font-size: .78rem; color: var(--muted); white-space: nowrap; }
        .file-item .status { font-size: .78rem; color: var(--accent); }
        .file-item button {
          background: transparent; border: 1px solid var(--border); color: var(--muted);
          border-radius: 6px; padding: .3rem .5rem; cursor: pointer; font-size: .78rem;
        }
        .file-item button:hover { border-color: var(--red); color: var(--red); }

        .step-section {
          background: var(--surface2); border: 1px solid var(--border);
          border-radius: var(--radius); padding: 1rem 1.25rem;
        }
        .step-section h3 { font-size: .95rem; font-weight: 700; color: var(--text); margin-bottom: .5rem; }
        .step-section p { font-size: .85rem; color: var(--muted); margin-bottom: .75rem; line-height: 1.6; }

        .code-box {
          background: var(--surface); border: 1px solid var(--border); border-radius: 8px;
          padding: .75rem; font-family: ui-monospace, monospace; font-size: .72rem;
          word-break: break-all; max-height: 120px; overflow-y: auto; margin-bottom: .75rem;
          color: var(--text); line-height: 1.5;
        }

        textarea {
          width: 100%; background: var(--surface); border: 1px solid var(--border);
          border-radius: 8px; padding: .75rem; font-family: ui-monospace, monospace;
          font-size: .78rem; color: var(--text); resize: vertical; margin-bottom: .75rem;
        }
        textarea:focus { outline: none; border-color: var(--accent); }

        .connection-status {
          font-size: .85rem; color: var(--muted); min-height: 1.25rem; text-align: center;
        }
        .connection-status.error { color: var(--red); }
        .connection-status.success { color: var(--green); }

        .transfer-area {
          margin-top: 1rem; background: var(--surface2); border: 1px solid var(--accent);
          border-radius: var(--radius); padding: 1rem 1.25rem;
        }
        .transfer-header {
          display: flex; align-items: center; justify-content: space-between;
          margin-bottom: .75rem; gap: .5rem;
        }
        .transfer-header span { font-size: .9rem; font-weight: 600; color: var(--text); }

        .progress-bar {
          width: 100%; height: 8px; background: var(--surface); border-radius: 99px;
          overflow: hidden;
        }
        .progress-bar .fill {
          height: 100%; width: 0%; background: var(--accent); border-radius: 99px;
          transition: width .2s;
        }
        .transfer-info { font-size: .8rem; color: var(--muted); margin-top: .5rem; }

        .btn {
          border: none; border-radius: 8px; padding: .55rem 1.1rem; font-size: .85rem;
          font-weight: 600; cursor: pointer; transition: all .2s;
        }
        .btn:disabled { opacity: .5; cursor: not-allowed; }
        .btn-primary { background: var(--accent); color: #fff; }
        .btn-primary:hover:not(:disabled) { filter: brightness(1.1); }
        .btn-secondary { background: var(--surface); border: 1px solid var(--border); color: var(--text); }
        .btn-secondary:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); }

        @media (max-width: 640px) {
          .role-selector { flex-direction: column; }
        }
  </style>

  <script is:inline>
    'use strict';

    const ICE_SERVERS = { iceServers: [{ urls: 'stun:stun.l.google.com:19302' }] };
    const CHUNK_SIZE = 16 * 1024;
    const MAX_FILE_SIZE = 500 * 1024 * 1024;

    let role = 'send';
    let pc = null;
    let dc = null;
    let selectedFiles = [];
    let receivedFiles = [];
    let currentTransferIdx = 0;
    let currentOffset = 0;
    let currentReceivedChunks = [];
    let currentReceivedSize = 0;
    let currentReceivedMeta = null;

    function selectRole(r) {
      role = r;
      document.getElementById('sendBtn').classList.toggle('active', r === 'send');
      document.getElementById('recvBtn').classList.toggle('active', r === 'recv');
      document.getElementById('sendPanel').style.display = r === 'send' ? '' : 'none';
      document.getElementById('recvPanel').style.display = r === 'recv' ? '' : 'none';
    }

    // --- File selection UI (sender) ---
    const sendDropZone = document.getElementById('sendDropZone');
    const sendFileInput = document.getElementById('sendFileInput');
    const sendFileList = document.getElementById('sendFileList');
    const sendStep1 = document.getElementById('sendStep1');

    sendDropZone.addEventListener('click', () => sendFileInput.click());
    sendDropZone.addEventListener('dragover', (e) => { e.preventDefault(); sendDropZone.classList.add('drag-over'); });
    sendDropZone.addEventListener('dragleave', () => sendDropZone.classList.remove('drag-over'));
    sendDropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      sendDropZone.classList.remove('drag-over');
      handleSelectedFiles(e.dataTransfer.files);
    });
    sendFileInput.addEventListener('change', () => {
      handleSelectedFiles(sendFileInput.files);
      sendFileInput.value = '';
    });

    function handleSelectedFiles(fileListObj) {
      const newFiles = Array.from(fileListObj);
      const tooLarge = newFiles.filter(f => f.size > MAX_FILE_SIZE);
      if (tooLarge.length > 0) {
        showSendStatus('File too large. Maximum is 500 MB.', 'error');
        return;
      }
      selectedFiles = selectedFiles.concat(newFiles);
      renderSendFiles();
      sendStep1.style.display = '';
    }

    function formatSize(bytes) {
      if (bytes === 0) return '0 B';
      const units = ['B', 'KB', 'MB', 'GB'];
      const i = Math.floor(Math.log(bytes) / Math.log(1024));
      return (bytes / Math.pow(1024, i)).toFixed(i > 0 ? 1 : 0) + ' ' + units[i];
    }

    function renderSendFiles() {
      sendFileList.replaceChildren();
      selectedFiles.forEach((file, idx) => {
        const item = document.createElement('div');
        item.className = 'file-item';
        const name = document.createElement('span');
        name.className = 'name';
        name.textContent = file.name;
        const size = document.createElement('span');
        size.className = 'size';
        size.textContent = formatSize(file.size);
        const btn = document.createElement('button');
        btn.textContent = '×';
        btn.title = 'Remove';
        btn.addEventListener('click', () => { selectedFiles.splice(idx, 1); renderSendFiles(); if (selectedFiles.length === 0) sendStep1.style.display = 'none'; });
        item.appendChild(name);
        item.appendChild(size);
        item.appendChild(btn);
        sendFileList.appendChild(item);
      });
    }

    function showSendStatus(msg, type) {
      const el = document.getElementById('sendStatus');
      el.textContent = msg;
      el.className = 'connection-status' + (type ? ' ' + type : '');
    }
    function showRecvStatus(msg, type) {
      const el = document.getElementById('recvStatus');
      el.textContent = msg;
      el.className = 'connection-status' + (type ? ' ' + type : '');
    }

    // --- WebRTC connection ---
    function createPeer() {
      pc = new RTCPeerConnection(ICE_SERVERS);
      pc.onconnectionstatechange = () => {
        if (pc.connectionState === 'connected') {
          showSendStatus('Connected!', 'success');
          showRecvStatus('Connected!', 'success');
          document.getElementById('transferArea').style.display = '';
          if (role === 'send') startSending();
        } else if (pc.connectionState === 'disconnected' || pc.connectionState === 'failed') {
          showSendStatus('Connection lost.', 'error');
          showRecvStatus('Connection lost.', 'error');
        }
      };
      return pc;
    }

    // --- SENDER FLOW ---
    async function createOffer() {
      const btn = document.getElementById('createOfferBtn');
      btn.disabled = true;
      btn.textContent = 'Creating…';
      showSendStatus('Creating connection code…', '');

      try {
        pc = createPeer();
        dc = pc.createDataChannel('file-transfer', { ordered: true });
        setupDataChannel(dc);

        const offer = await pc.createOffer();
        await pc.setLocalDescription(offer);
        await waitForIce(pc);

        const code = btoa(JSON.stringify({ sdp: pc.localDescription }));
        const codeBox = document.getElementById('offerCodeBox');
        codeBox.textContent = code;
        document.getElementById('sendStep2').style.display = '';
        document.getElementById('sendStep3').style.display = '';
        btn.textContent = 'Code created ✓';
        showSendStatus('Share the code above with the receiving device.', '');
      } catch (err) {
        console.error(err);
        showSendStatus('Error creating connection: ' + (err.message || 'unknown error'), 'error');
        btn.disabled = false;
        btn.textContent = 'Create connection code';
      }
    }

    async function acceptAnswer() {
      const input = document.getElementById('answerInput');
      const btn = document.getElementById('acceptAnswerBtn');
      btn.disabled = true;
      btn.textContent = 'Connecting…';
      showSendStatus('Establishing connection…', '');

      try {
        const answer = JSON.parse(atob(input.value.trim()));
        await pc.setRemoteDescription(new RTCSessionDescription(answer.sdp));
        btn.textContent = 'Connecting…';
      } catch (err) {
        console.error(err);
        showSendStatus('Invalid answer code. Please check and try again.', 'error');
        btn.disabled = false;
        btn.textContent = 'Connect';
      }
    }

    // --- RECEIVER FLOW ---
    async function acceptOffer() {
      const input = document.getElementById('offerInput');
      const btn = document.getElementById('acceptOfferBtn');
      btn.disabled = true;
      btn.textContent = 'Processing…';
      showRecvStatus('Creating answer code…', '');

      try {
        pc = createPeer();
        pc.ondatachannel = (event) => {
          dc = event.channel;
          setupDataChannel(dc);
        };

        const offer = JSON.parse(atob(input.value.trim()));
        await pc.setRemoteDescription(new RTCSessionDescription(offer.sdp));

        const answer = await pc.createAnswer();
        await pc.setLocalDescription(answer);
        await waitForIce(pc);

        const code = btoa(JSON.stringify({ sdp: pc.localDescription }));
        const codeBox = document.getElementById('answerCodeBox');
        codeBox.textContent = code;
        document.getElementById('recvStep2').style.display = '';
        btn.textContent = 'Answer ready ✓';
        showRecvStatus('Share the answer code with the sending device.', '');
      } catch (err) {
        console.error(err);
        showRecvStatus('Invalid connection code. Please check and try again.', 'error');
        btn.disabled = false;
        btn.textContent = 'Accept connection';
      }
    }

    // --- Data channel setup ---
    function setupDataChannel(channel) {
      channel.binaryType = 'arraybuffer';

      channel.onopen = () => {
        document.getElementById('transferArea').style.display = '';
        if (role === 'send') startSending();
      };

      channel.onmessage = (event) => {
        if (typeof event.data === 'string') {
          const msg = JSON.parse(event.data);
          if (msg.type === 'file-meta') {
            currentReceivedMeta = msg;
            currentReceivedChunks = [];
            currentReceivedSize = 0;
            addRecvFileItem(msg.name, msg.size);
            updateTransferProgress(0, msg.size, msg.name);
          } else if (msg.type === 'file-done') {
            saveReceivedFile(currentReceivedMeta, currentReceivedChunks);
            currentReceivedMeta = null;
            currentReceivedChunks = [];
            currentReceivedSize = 0;
          } else if (msg.type === 'all-done') {
            showRecvStatus('All files received!', 'success');
            document.getElementById('transferTitle').textContent = 'All files received ✓';
            document.getElementById('transferFill').style.width = '100%';
          }
        } else {
          currentReceivedChunks.push(event.data);
          currentReceivedSize += event.data.byteLength;
          if (currentReceivedMeta) {
            updateTransferProgress(currentReceivedSize, currentReceivedMeta.size, currentReceivedMeta.name);
          }
        }
      };

      channel.onclose = () => {
        showSendStatus('Connection closed.', '');
        showRecvStatus('Connection closed.', '');
      };

      channel.onerror = (err) => {
        console.error('Data channel error:', err);
        showSendStatus('Transfer error.', 'error');
        showRecvStatus('Transfer error.', 'error');
      };
    }

    // --- Sending files ---
    function startSending() {
      currentTransferIdx = 0;
      sendNextFile();
    }

    async function sendNextFile() {
      if (currentTransferIdx >= selectedFiles.length) {
        dc.send(JSON.stringify({ type: 'all-done' }));
        document.getElementById('transferTitle').textContent = 'All files sent ✓';
        document.getElementById('transferFill').style.width = '100%';
        showSendStatus('All files sent!', 'success');
        return;
      }

      const file = selectedFiles[currentTransferIdx];
      dc.send(JSON.stringify({ type: 'file-meta', name: file.name, size: file.size, mime: file.type }));
      currentOffset = 0;
      updateTransferProgress(0, file.size, file.name);

      function sendChunk() {
        if (!dc || dc.readyState !== 'open') return;
        const end = Math.min(currentOffset + CHUNK_SIZE, file.size);
        const slice = file.slice(currentOffset, end);
        const reader = new FileReader();

        reader.onload = () => {
          dc.send(reader.result);
          currentOffset = end;
          updateTransferProgress(currentOffset, file.size, file.name);

          if (currentOffset < file.size) {
            if (dc.bufferedAmount < 4 * 1024 * 1024) {
              sendChunk();
            } else {
              setTimeout(sendChunk, 20);
            }
          } else {
            dc.send(JSON.stringify({ type: 'file-done' }));
            currentTransferIdx++;
            setTimeout(sendNextFile, 100);
          }
        };

        reader.onerror = () => {
          console.error('File read error');
          showSendStatus('Error reading file: ' + file.name, 'error');
        };

        reader.readAsArrayBuffer(slice);
      }

      sendChunk();
    }

    // --- Receiving files ---
    function addRecvFileItem(name, size) {
      const list = document.getElementById('recvFileList');
      const item = document.createElement('div');
      item.className = 'file-item';
      const nameSpan = document.createElement('span');
      nameSpan.className = 'name';
      nameSpan.textContent = name;
      const sizeSpan = document.createElement('span');
      sizeSpan.className = 'size';
      sizeSpan.textContent = formatSize(size);
      const status = document.createElement('span');
      status.className = 'status';
      status.textContent = 'Receiving…';
      item.appendChild(nameSpan);
      item.appendChild(sizeSpan);
      item.appendChild(status);
      list.appendChild(item);
    }

    function saveReceivedFile(meta, chunks) {
      const blob = new Blob(chunks, { type: meta.mime || 'application/octet-stream' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = meta.name;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      setTimeout(() => URL.revokeObjectURL(url), 1000);

      const items = document.querySelectorAll('#recvFileList .file-item');
      const last = items[items.length - 1];
      if (last) {
        const status = last.querySelector('.status');
        if (status) status.textContent = 'Downloaded ✓';
      }
    }

    // --- Progress ---
    function updateTransferProgress(current, total, name) {
      const pct = total > 0 ? Math.round((current / total) * 100) : 0;
      document.getElementById('transferFill').style.width = pct + '%';
      document.getElementById('transferInfo').textContent = name + ' — ' + formatSize(current) + ' / ' + formatSize(total) + ' (' + pct + '%)';
      document.getElementById('transferTitle').textContent = 'Transferring: ' + name;
    }

    // --- Utilities ---
    function waitForIce(pc) {
      return new Promise((resolve) => {
        if (pc.iceGatheringState === 'complete') { resolve(); return; }
        const checkState = () => { if (pc.iceGatheringState === 'complete') { pc.removeEventListener('icegatheringstatechange', checkState); resolve(); } };
        pc.addEventListener('icegatheringstatechange', checkState);
        setTimeout(resolve, 3000);
      });
    }

    function copyCode(boxId) {
      const text = document.getElementById(boxId).textContent;
      navigator.clipboard.writeText(text).then(() => {
        const btn = event.target;
        const orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(() => { btn.textContent = orig; }, 1800);
      });
    }

    function disconnect() {
      if (dc) { try { dc.close(); } catch(e){} dc = null; }
      if (pc) { try { pc.close(); } catch(e){} pc = null; }
      document.getElementById('transferArea').style.display = 'none';
      showSendStatus('Disconnected.', '');
      showRecvStatus('Disconnected.', '');
    }
  </script>
</Layout>
